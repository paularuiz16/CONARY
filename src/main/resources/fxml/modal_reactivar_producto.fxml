<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<StackPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.conary.rosita.controller.ReactivarProductoController"
           styleClass="modal-prod-backdrop">
    <padding>
        <Insets top="14" right="14" bottom="14" left="14"/>
    </padding>

    <VBox spacing="16" prefWidth="500" maxWidth="500" styleClass="modal-prod-card">

        <!-- Cabecera del Modal -->
        <HBox alignment="CENTER_LEFT" spacing="14">
            <StackPane styleClass="modal-prod-icon-box">
                <SVGPath fill="transparent" stroke="#5C3419" strokeWidth="1.7"
                         content="M 2.2 6.0 C 2.9 3.2 5.4 1.2 8.4 1.2 C 11.1 1.2 13.4 2.9 14.3 5.3 M 14.5 2.2 L 14.5 5.6 L 11.1 5.6 M 14.4 9.8 C 13.7 12.6 11.2 14.6 8.2 14.6 C 5.5 14.6 3.2 12.9 2.3 10.5 M 2.1 13.6 L 2.1 10.2 L 5.5 10.2"/>
            </StackPane>
            <Label text="¿Volver a activar este producto?" styleClass="modal-prod-title" wrapText="true"/>
        </HBox>

        <!-- Tarjeta de Producto Seleccionado -->
        <VBox spacing="3" styleClass="modal-prod-product-box">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Circle radius="3.8" fill="#6B3A19"/>
                <Label fx:id="lblProductoResumen"
                       text="Marcador permanente negro · PRD-005"
                       wrapText="true" styleClass="modal-prod-product-name"/>
            </HBox>
            <Label fx:id="lblFechaBaja"
                   text="Dado de baja del catálogo activo"
                   styleClass="modal-prod-product-subtext"/>
        </VBox>

        <!-- Lista de 3 Puntos Informativos -->
        <VBox spacing="10">
            <!-- Punto 1 -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane styleClass="modal-prod-consequence-circle">
                    <SVGPath fill="transparent" stroke="#6B4C35" strokeWidth="1.4"
                             content="M 1 1.5 L 2.8 1.5 L 4.5 8.5 L 11.5 8.5 L 13 3.5 L 3.4 3.5 M 5.2 11.2 C 4.7 11.2 4.3 11.6 4.3 12.1 C 4.3 12.6 4.7 13.0 5.2 13.0 C 5.7 13.0 6.1 12.6 6.1 12.1 C 6.1 11.6 5.7 11.2 5.2 11.2 Z M 10.8 11.2 C 10.3 11.2 9.9 11.6 9.9 12.1 C 9.9 12.6 10.3 13.0 10.8 13.0 C 11.3 13.0 11.7 12.6 11.7 12.1 C 11.7 11.6 11.3 11.2 10.8 11.2 Z"/>
                </StackPane>
                <Label text="Volverá a aparecer al vender y al comprar."
                       wrapText="true" styleClass="modal-prod-consequence-text"/>
            </HBox>

            <!-- Punto 2 -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane styleClass="modal-prod-consequence-circle">
                    <SVGPath fill="transparent" stroke="#6B4C35" strokeWidth="1.4"
                             content="M 1 2 L 6 2 C 6.8 2 7.5 2.7 7.5 3.5 L 7.5 11.5 C 7.5 10.8 6.8 10.2 6 10.2 L 1 10.2 Z M 14 2 L 9 2 C 8.2 2 7.5 2.7 7.5 3.5 L 7.5 11.5 C 7.5 10.8 8.2 10.2 9 10.2 L 14 10.2 Z"/>
                </StackPane>
                <Label text="Conserva sus datos y su historial."
                       wrapText="true" styleClass="modal-prod-consequence-text"/>
            </HBox>

            <!-- Punto 3 -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane styleClass="modal-prod-consequence-circle">
                    <SVGPath fill="transparent" stroke="#6B4C35" strokeWidth="1.4"
                             content="M 9.5 1.5 L 12.5 4.5 L 4.5 12.5 L 1.5 12.5 L 1.5 9.5 L 9.5 1.5 Z"/>
                </StackPane>
                <Label fx:id="lblPrecioActualInfo"
                       text="Precio actual: \$ 2.500. Si cambió, modifíquelo después."
                       wrapText="true" styleClass="modal-prod-consequence-text"/>
            </HBox>
        </VBox>

        <!-- Aviso Condicional de Existencias Cero (visible solo si stock == 0) -->
        <HBox fx:id="boxAvisoStockCero" alignment="CENTER_LEFT" spacing="10"
              styleClass="modal-prod-diff-amber">
            <Label text="⚠" styleClass="modal-prod-diff-icon"/>
            <Label text="Existencias: 0. Si ya tiene unidades, use Ajustar existencias."
                   wrapText="true" styleClass="modal-prod-diff-text" HBox.hgrow="ALWAYS"/>
        </HBox>

        <!-- Botones Inferiores (50% / 50%) -->
        <HBox spacing="12" alignment="CENTER">
            <Button fx:id="btnNoVolver" text="←   No, volver" onAction="#handleCancelar"
                    maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="modal-prod-btn-cancel"/>
            <Button fx:id="btnConfirmarReactivar" text="  Sí, volver a activar"
                    onAction="#handleConfirmarReactivar"
                    maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="modal-prod-btn-save">
                <graphic>
                    <SVGPath fill="transparent" stroke="#FAF6F0" strokeWidth="1.6"
                             content="M 1.8 5.2 C 2.4 2.8 4.5 1.1 7.0 1.1 C 9.3 1.1 11.2 2.5 12.0 4.5 M 12.2 1.8 L 12.2 4.8 L 9.2 4.8 M 12.1 8.4 C 11.5 10.8 9.4 12.5 6.9 12.5 C 4.6 12.5 2.7 11.1 1.9 9.1 M 1.7 11.8 L 1.7 8.8 L 4.7 8.8"/>
                </graphic>
            </Button>
        </HBox>

    </VBox>
</StackPane>
