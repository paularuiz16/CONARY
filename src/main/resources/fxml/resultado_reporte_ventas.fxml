<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.conary.rosita.controller.ResultadoReporteVentasController"
            fx:id="rootPane"
            styleClass="cuenta-cliente-root"
            maxWidth="Infinity" maxHeight="Infinity">

    <!-- ==================================================================
         CABECERA LIMPIA ESTANDAR DE CONARY: RESULTADO REPORTE DE VENTAS
         ================================================================== -->
    <top>
        <VBox spacing="0">
            <padding>
                <Insets top="10" right="22" bottom="8" left="22"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="14" styleClass="cuenta-cliente-header-bar">
                <Button fx:id="btnVolverReportes" text="←   Volver a Reportes"
                        onAction="#handleVolverAReportes"
                        styleClass="cuenta-cliente-btn-volver"/>

                <StackPane styleClass="clientes-header-icon-box">
                    <SVGPath fill="transparent" stroke="#704214" strokeWidth="1.6"
                             content="M 1 2 L 3.2 2 L 5.2 9.5 L 12.5 9.5 L 14 4 L 4 4 M 6 12.5 C 6 13.1 5.5 13.5 5 13.5 C 4.5 13.5 4 13.1 4 12.5 M 12 12.5 C 12 13.1 11.5 13.5 11 13.5 C 10.5 13.5 10 13.1 10 12.5"/>
                </StackPane>

                <VBox spacing="1">
                    <Label text="Ventas" styleClass="clientes-header-title"/>
                    <Label fx:id="lblRangoSubtitulo" text="Del 01 al 01 de noviembre de 2026"
                           styleClass="cuenta-cliente-header-subtitle"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="btnGuardarReporte" text="💾   Guardar reporte"
                        onAction="#handleGuardarReporte"
                        styleClass="cuenta-cliente-btn-secondary"/>

                <!-- Capsula de Usuario en Sesion Real -->
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="clientes-user-pill">
                    <StackPane>
                        <Circle radius="14" fill="#5C300C"/>
                        <SVGPath fill="#FAF6F0"
                                 content="M 0 -5 C -2.2 -5 -4 -3.2 -4 -1 C -4 1.2 -2.2 3 0 3 C 2.2 3 4 1.2 4 -1 C 4 -3.2 2.2 -5 0 -5 Z M 0 5 C -3.5 5 -7 6.8 -7 9.5 L 7 9.5 C 7 6.8 3.5 5 0 5 Z"/>
                    </StackPane>
                    <Label fx:id="lblUsuarioHeader" text="Doña Rosita · Administradora"
                           styleClass="clientes-user-text"/>
                </HBox>
            </HBox>
        </VBox>
    </top>

    <!-- ==================================================================
         CONTENIDO CENTRAL: 4 KPIs, PESTANAS Y TABLA CON FILA DE TOTALES
         ================================================================== -->
    <center>
        <VBox spacing="12" VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="2" right="22" bottom="8" left="22"/>
            </padding>

            <!-- 1. 4 Tarjetas Superiores -->
            <GridPane hgap="14">
                <columnConstraints>
                    <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                </columnConstraints>

                <!-- Tarjeta 1: TOTAL VENDIDO (cafe oscuro #704214) -->
                <VBox spacing="4" styleClass="cuenta-proveedor-kpi-dark" GridPane.columnIndex="0">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="TOTAL VENDIDO" styleClass="cuenta-proveedor-kpi-dark-kicker"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <SVGPath fill="transparent" stroke="#F5E6D6" strokeWidth="1.5"
                                 content="M 1 3 L 15 3 L 15 12 L 1 12 Z M 8 5.5 C 6.9 5.5 6 6.4 6 7.5 C 6 8.6 6.9 9.5 8 9.5 C 9.1 9.5 10 8.6 10 7.5 C 10 6.4 9.1 5.5 8 5.5 Z"/>
                    </HBox>
                    <Label fx:id="lblTotalVendido" text="\$ 0" styleClass="cuenta-proveedor-kpi-dark-value"/>
                </VBox>

                <!-- Tarjeta 2: De contado -->
                <VBox spacing="4" styleClass="cuenta-proveedor-kpi-white" GridPane.columnIndex="1">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="De contado" styleClass="cuenta-cliente-kpi-kicker"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="\$" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #8C6D53;"/>
                    </HBox>
                    <Label fx:id="lblTotalContado" text="\$ 0" styleClass="cuenta-proveedor-kpi-value"/>
                </VBox>

                <!-- Tarjeta 3: A fiado -->
                <VBox spacing="4" styleClass="cuenta-proveedor-kpi-white" GridPane.columnIndex="2">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="A fiado" styleClass="cuenta-cliente-kpi-kicker"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <SVGPath fill="transparent" stroke="#8C6D53" strokeWidth="1.5"
                                 content="M 2 1 L 12 1 L 12 14 L 9.5 12.5 L 7 14 L 4.5 12.5 L 2 14 Z M 4.5 5 L 9.5 5 M 4.5 8 L 9.5 8"/>
                    </HBox>
                    <Label fx:id="lblTotalFiado" text="\$ 0" styleClass="cuenta-proveedor-kpi-value"/>
                </VBox>

                <!-- Tarjeta 4: Ventas -->
                <VBox spacing="4" styleClass="cuenta-proveedor-kpi-white" GridPane.columnIndex="3">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Ventas" styleClass="cuenta-cliente-kpi-kicker"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <SVGPath fill="transparent" stroke="#8C6D53" strokeWidth="1.5"
                                 content="M 2 4 L 12 4 L 13 13 L 1 13 Z M 4.5 4 L 4.5 2.5 C 4.5 1.5 5.5 1 7 1 C 8.5 1 9.5 1.5 9.5 2.5 L 9.5 4"/>
                    </HBox>
                    <Label fx:id="lblCantidadVentas" text="0" styleClass="cuenta-proveedor-kpi-value"/>
                </VBox>
            </GridPane>

            <!-- 2. Pestanas: Por dia / Por producto -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <ToggleButton fx:id="tbPorDia" text="📅   Por día" selected="true"
                              styleClass="clientes-filter-pill"/>
                <ToggleButton fx:id="tbPorProducto" text="📦   Por producto"
                              styleClass="clientes-filter-pill"/>
            </HBox>

            <!-- 3. Tarjeta de Tabla y Fila Fija de Totales -->
            <VBox spacing="0" VBox.vgrow="ALWAYS" styleClass="cuenta-cliente-table-card">
                <StackPane VBox.vgrow="ALWAYS">
                    <!-- Tabla 1: Por dia -->
                    <TableView fx:id="tblPorDia" styleClass="cuenta-cliente-table">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colDia" text="Día" prefWidth="240"/>
                            <TableColumn fx:id="colDiaVentas" text="Ventas" prefWidth="140"/>
                            <TableColumn fx:id="colDiaContado" text="De contado" prefWidth="200"/>
                            <TableColumn fx:id="colDiaFiado" text="A fiado" prefWidth="180"/>
                            <TableColumn fx:id="colDiaTotal" text="Total" prefWidth="200"/>
                        </columns>
                        <placeholder>
                            <VBox alignment="CENTER" spacing="6" style="-fx-padding: 32;">
                                <Label text="No se encontraron ventas válidas en este rango de fechas."
                                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #6B4C35;"/>
                            </VBox>
                        </placeholder>
                    </TableView>

                    <!-- Tabla 2: Por producto -->
                    <TableView fx:id="tblPorProducto" visible="false" managed="false"
                               styleClass="cuenta-cliente-table">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colProducto" text="Producto" prefWidth="280"/>
                            <TableColumn fx:id="colProdUnidades" text="Unidades" prefWidth="120"/>
                            <TableColumn fx:id="colProdContado" text="De contado" prefWidth="190"/>
                            <TableColumn fx:id="colProdFiado" text="A fiado" prefWidth="180"/>
                            <TableColumn fx:id="colProdTotal" text="Total" prefWidth="190"/>
                        </columns>
                        <placeholder>
                            <VBox alignment="CENTER" spacing="6" style="-fx-padding: 32;">
                                <Label text="No se vendieron productos válidos en este rango de fechas."
                                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #6B4C35;"/>
                            </VBox>
                        </placeholder>
                    </TableView>
                </StackPane>

                <!-- Fila Fija de Totales al final de la tabla -->
                <GridPane styleClass="rep-ventas-totals-row">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="15" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="20" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="19" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="21" hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Total" styleClass="rep-ventas-total-label" GridPane.columnIndex="0"/>
                    <Label fx:id="lblFilaTotalConteo" text="0" styleClass="rep-ventas-total-label"
                           GridPane.columnIndex="1" GridPane.halignment="CENTER"/>
                    <Label fx:id="lblFilaTotalContado" text="\$ 0" styleClass="rep-ventas-total-label"
                           GridPane.columnIndex="2" GridPane.halignment="RIGHT"/>
                    <Label fx:id="lblFilaTotalFiado" text="\$ 0" styleClass="rep-ventas-total-label"
                           GridPane.columnIndex="3" GridPane.halignment="RIGHT"/>
                    <Label fx:id="lblFilaTotalGeneral" text="\$ 0" styleClass="rep-ventas-total-underline"
                           GridPane.columnIndex="4" GridPane.halignment="RIGHT"/>
                </GridPane>
            </VBox>

            <!-- 4. Nota inferior real sobre ventas anuladas -->
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label fx:id="lblNotaAnuladas" text="ℹ  No cuentan 0 ventas anuladas."
                       styleClass="cuenta-cliente-footer-text"/>
            </HBox>
        </VBox>
    </center>

    <!-- Pie discreto -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="8">
            <padding>
                <Insets top="0" right="22" bottom="8" left="22"/>
            </padding>
            <Circle radius="4" fill="#704214"/>
            <Label text="Datos guardados en este equipo" styleClass="clientes-footer-saved"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Papelería de Rosita · CONARY v1.0" styleClass="clientes-footer-saved"/>
        </HBox>
    </bottom>

</BorderPane>