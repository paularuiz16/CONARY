<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.conary.rosita.controller.PasarDatosExcelController"
            fx:id="rootPane"
            styleClass="clientes-root"
            maxWidth="Infinity" maxHeight="Infinity">

    <!-- ==================================================================
         CABECERA LIMPIA (SIN MENU LATERAL)
         ================================================================== -->
    <top>
        <VBox spacing="0">
            <padding>
                <Insets top="10" right="18" bottom="8" left="18"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="14" styleClass="clientes-header-bar">
                <Button fx:id="btnVolverMasOpciones" text="←   Volver a Más opciones"
                        onAction="#handleCancelar"
                        styleClass="clientes-btn-volver"/>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox alignment="CENTER" spacing="10">
                    <StackPane styleClass="clientes-header-icon-box">
                        <SVGPath fill="transparent" stroke="#704214" strokeWidth="1.7"
                                 content="M 3 1 L 11 1 L 15 5 L 15 16 C 15 16.8 14.3 17.5 13.5 17.5 L 3 17.5 C 2.2 17.5 1.5 16.8 1.5 16 L 1.5 2.5 C 1.5 1.7 2.2 1 3 1 Z M 11 1 L 11 5 L 15 5 M 4.5 9.5 L 10.5 9.5 M 8.5 7 L 11 9.5 L 8.5 12 M 5 14 L 12 14"/>
                    </StackPane>
                    <Label text="Pasar datos del Excel" styleClass="clientes-header-title"/>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="clientes-user-pill">
                    <StackPane>
                        <Circle radius="14" fill="#5C300C"/>
                        <SVGPath fill="#FAF6F0"
                                 content="M 0 -5 C -2.2 -5 -4 -3.2 -4 -1 C -4 1.2 -2.2 3 0 3 C 2.2 3 4 1.2 4 -1 C 4 -3.2 2.2 -5 0 -5 Z M 0 5 C -3.5 5 -7 6.8 -7 9.5 L 7 9.5 C 7 6.8 3.5 5 0 5 Z"/>
                    </StackPane>
                    <Label fx:id="lblUsuarioHeader" text="Doña Rosita · Administradora"
                           styleClass="clientes-user-text"/>
                </HBox>
            </HBox>
        </VBox>
    </top>

    <!-- ==================================================================
         CUERPO: 2 TARJETAS BLANCAS LADO A LADO (35% / 65%)
         ================================================================== -->
    <center>
        <GridPane hgap="18" maxWidth="Infinity" maxHeight="Infinity">
            <padding>
                <Insets top="4" right="20" bottom="16" left="20"/>
            </padding>
            <columnConstraints>
                <ColumnConstraints percentWidth="35" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="65" hgrow="ALWAYS"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints vgrow="ALWAYS"/>
            </rowConstraints>

            <!-- TARJETA IZQUIERDA: 1. Elija el archivo -->
            <VBox spacing="16" GridPane.columnIndex="0" maxHeight="Infinity" styleClass="excel-card">
                <Label text="1. Elija el archivo" styleClass="excel-section-title"/>

                <Label text="Es el Excel donde la secretaria anotaba las ventas. Se pasa una sola vez."
                       wrapText="true" styleClass="excel-desc-18"/>

                <Button fx:id="btnElegirArchivo" text="📁   Elegir archivo"
                        onAction="#handleElegirArchivo"
                        maxWidth="Infinity" styleClass="excel-btn-elegir"/>

                <HBox fx:id="boxArchivoSeleccionado" alignment="CENTER_LEFT" spacing="8"
                      visible="false" managed="false" styleClass="excel-archivo-ok-box">
                    <Label fx:id="lblArchivoSeleccionado" text="✓ ventas.xlsx"
                           wrapText="true" HBox.hgrow="ALWAYS" styleClass="excel-archivo-ok-text"/>
                </HBox>

                <Region VBox.vgrow="ALWAYS"/>

                <Label text="El archivo debe tener: fecha, producto, valor unitario, cantidad y valor total."
                       wrapText="true" styleClass="excel-help-16"/>
            </VBox>

            <!-- TARJETA DERECHA: 2. Revise antes de pasar -->
            <VBox spacing="12" GridPane.columnIndex="1" maxHeight="Infinity" styleClass="excel-card">
                <Label text="2. Revise antes de pasar" styleClass="excel-section-title"/>

                <!-- Fila de 4 indicadores en serif -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label fx:id="lblFilasLeidas" text="Filas leídas: 0"
                           HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="excel-kpi-pill"/>
                    <Label fx:id="lblFilasBien" text="Bien: 0"
                           HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="excel-kpi-pill"/>
                    <Label fx:id="lblConProblemas" text="⚠ Con problemas: 0"
                           HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="excel-kpi-pill-warn"/>
                    <Label fx:id="lblProductosNuevos" text="Productos nuevos: 0"
                           HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="excel-kpi-pill"/>
                </HBox>

                <Label text="Así se verán" styleClass="excel-subtitulo-tabla"/>

                <!-- Tabla desplazable solo por dentro con filas de 56px -->
                <TableView fx:id="tblVistaPrevia" fixedCellSize="56"
                           minHeight="168" prefHeight="240" VBox.vgrow="ALWAYS"
                           styleClass="excel-preview-table">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colFecha" text="Fecha" prefWidth="120" minWidth="105" maxWidth="145"/>
                        <TableColumn fx:id="colProducto" text="Producto" prefWidth="255" minWidth="180"/>
                        <TableColumn fx:id="colValorUnitario" text="Valor unitario" prefWidth="135" minWidth="115" maxWidth="160"/>
                        <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="105" minWidth="90" maxWidth="120"/>
                        <TableColumn fx:id="colTotal" text="Total" prefWidth="135" minWidth="115" maxWidth="160"/>
                    </columns>
                    <placeholder>
                        <Label text="Elija un archivo a la izquierda para revisar las ventas antes de pasarlas."
                               wrapText="true" styleClass="excel-help-16"/>
                    </placeholder>
                </TableView>

                <!-- Bloque ambar de filas que no se pasaran (visible solo si hay problemas) -->
                <VBox fx:id="boxErroresRevision" spacing="6" visible="false" managed="false"
                      styleClass="excel-errores-box">
                    <Label text="⚠   Estas filas no se pasarán" styleClass="excel-errores-titulo"/>
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" maxHeight="92"
                                style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                        <content>
                            <VBox fx:id="boxListaErrores" spacing="3"/>
                        </content>
                    </ScrollPane>
                </VBox>

                <!-- Nota de seguridad -->
                <Label text="🔒   Estas ventas son de antes. No cambian las existencias ni la caja."
                       wrapText="true" styleClass="excel-help-16"/>

                <!-- Botones inferiores (56px / 48px) -->
                <Button fx:id="btnPasarDatos" text="  Pasar los datos"
                        onAction="#handlePasarDatos"
                        disable="true" maxWidth="Infinity" styleClass="excel-btn-pasar">
                    <graphic>
                        <SVGPath fill="transparent" stroke="#FAF6F0" strokeWidth="2.0"
                                 content="M 1 6 L 11 6 M 7.5 2.5 L 11 6 L 7.5 9.5 M 14 1 L 14 11"/>
                    </graphic>
                </Button>

                <Button fx:id="btnCancelar" text="Cancelar"
                        onAction="#handleCancelar"
                        maxWidth="Infinity" styleClass="excel-btn-cancelar"/>
            </VBox>
        </GridPane>
    </center>

</BorderPane>
