<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.conary.rosita.controller.MainController"
            styleClass="dashboard-bg"
            stylesheets="@../css/styles.css"
            prefWidth="1180" prefHeight="780">

    <padding>
        <Insets top="14" right="18" bottom="14" left="18"/>
    </padding>

    <!-- ==================================================================
         FILA 1: BARRA SUPERIOR (HEADER)
         ================================================================== -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="dashboard-header-card">
            <BorderPane.margin>
                <Insets bottom="12"/>
            </BorderPane.margin>

            <Label text="Papelería de Rosita" styleClass="dashboard-brand-title"/>

            <!-- Boton para regresar al Dashboard cuando se abre un modulo hijo -->
            <Button fx:id="btnVolverMenu" text="← Volver al Menú Principal"
                    onAction="#mostrarMenuDashboard"
                    visible="false" managed="false"
                    styleClass="dashboard-btn-volver">
                <HBox.margin>
                    <Insets left="12"/>
                </HBox.margin>
            </Button>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Etiqueta legacy oculta para preservar compatibilidad -->
            <Label fx:id="lblUsuarioLogueado" text="" visible="false" managed="false"/>

            <!-- Capsula de Usuario Logueado -->
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="dashboard-user-pill">
                <StackPane styleClass="dashboard-user-avatar">
                    <SVGPath fill="#FAF6F0" content="M 6 6 C 7.66 6 9 4.66 9 3 C 9 1.34 7.66 0 6 0 C 4.34 0 3 1.34 3 3 C 3 4.66 4.34 6 6 6 Z M 6 7.5 C 3.67 7.5 0 8.67 0 11 L 0 12 L 12 12 L 12 11 C 12 8.67 8.33 7.5 6 7.5 Z"/>
                </StackPane>
                <VBox alignment="CENTER_LEFT" spacing="0">
                    <Label fx:id="lblNombreUsuario" text="Doña Rosita" styleClass="dashboard-user-name"/>
                    <Label fx:id="lblRolUsuario" text="Administradora" styleClass="dashboard-user-role"/>
                </VBox>
            </HBox>

            <!-- Boton Salir -->
            <Button fx:id="btnCerrarSesion" text="Salir" onAction="#handleCerrarSesion"
                    styleClass="dashboard-btn-salir"/>
        </HBox>
    </top>

    <!-- ==================================================================
         AREA CENTRAL DINAMICA (Contiene el Dashboard por defecto)
         ================================================================== -->
    <center>
        <StackPane fx:id="contentArea">

            <!-- CONTENEDOR DEL MENU PRINCIPAL (FILAS 2 A 6) -->
            <VBox fx:id="paneDashboard" spacing="12" maxWidth="Infinity" maxHeight="Infinity">

                <!-- FILA 2: BANNER DE BIENVENIDA Y FECHA REAL -->
                <HBox alignment="CENTER_LEFT" spacing="16" styleClass="dashboard-row-card">
                    <StackPane styleClass="dashboard-store-icon-box">
                        <SVGPath fill="#704214" content="M 15 2 L 1 2 L 1 4 L 15 4 L 15 2 Z M 16 10 L 16 8 L 15 4.5 L 1 4.5 L 0 8 L 0 10 L 1 10 L 1 15 L 10 15 L 10 10 L 13 10 L 13 15 L 15 15 L 15 10 L 16 10 Z M 8 13 L 3 13 L 3 10 L 8 10 L 8 13 Z"/>
                    </StackPane>

                    <VBox alignment="CENTER_LEFT" spacing="2">
                        <Label text="MENÚ PRINCIPAL" styleClass="dashboard-kicker"/>
                        <Label fx:id="lblSaludo" text="¡Buenos días, Doña Rosita!" styleClass="dashboard-greeting"/>
                        <Label text="Toque o haga clic con calma en el botón que necesita usar hoy:" styleClass="dashboard-greeting-sub"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <!-- Caja de Fecha Real -->
                    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="dashboard-date-box">
                        <SVGPath fill="transparent" stroke="#704214" strokeWidth="1.6"
                                 content="M 2 3 L 14 3 C 14.55 3 15 3.45 15 4 L 15 15 C 15 15.55 14.55 16 14 16 L 2 16 C 1.45 16 1 15.55 1 15 L 1 4 C 1 3.45 1.45 3 2 3 Z M 1 7 L 15 7 M 5 1 L 5 4 M 11 1 L 11 4"/>
                        <VBox alignment="CENTER_LEFT" spacing="1">
                            <Label text="Fecha de hoy" styleClass="dashboard-date-label"/>
                            <Label fx:id="lblFechaHoy" text="Viernes, 13 de noviembre de 2026" styleClass="dashboard-date-value"/>
                        </VBox>
                    </HBox>
                </HBox>

                <!-- FILA 3: CUADRICULA PRINCIPAL DE 6 MODULOS (3x2) -->
                <GridPane hgap="14" vgap="14" VBox.vgrow="ALWAYS">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="33.34" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints percentHeight="50.0" vgrow="ALWAYS"/>
                        <RowConstraints percentHeight="50.0" vgrow="ALWAYS"/>
                    </rowConstraints>

                    <!-- Modulo 1: Vender (Mostrador principal) -->
                    <Button fx:id="btnNavVenta" onAction="#mostrarPuntoVenta"
                            maxWidth="Infinity" maxHeight="Infinity"
                            styleClass="dashboard-module-card-primary"
                            GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <graphic>
                            <StackPane maxWidth="Infinity" maxHeight="Infinity" prefWidth="340" prefHeight="150">
                                <Label text="PRINCIPAL" styleClass="dashboard-badge-principal"
                                       StackPane.alignment="TOP_RIGHT"/>
                                <VBox alignment="CENTER" spacing="6">
                                    <StackPane styleClass="dashboard-module-icon-circle">
                                        <SVGPath fill="#704214" content="M 4.5 14 C 3.67 14 3.01 14.67 3.01 15.5 C 3.01 16.33 3.67 17 4.5 17 C 5.33 17 6 16.33 6 15.5 C 6 14.67 5.33 14 4.5 14 Z M 0 1 L 0 2.5 L 1.5 2.5 L 4.2 8.2 L 3.2 10 C 3.07 10.22 3 10.48 3 10.75 C 3 11.58 3.67 12.25 4.5 12.25 L 13.5 12.25 L 13.5 10.75 L 4.82 10.75 C 4.71 10.75 4.63 10.67 4.63 10.56 L 4.65 10.47 L 5.33 9.25 L 10.92 9.25 C 11.48 9.25 11.97 8.94 12.23 8.48 L 14.91 3.61 C 14.97 3.5 15 3.38 15 3.25 C 15 2.83 14.66 2.5 14.25 2.5 L 3.16 2.5 L 2.45 1 L 0 1 Z M 12 14 C 11.17 14 10.51 14.67 10.51 15.5 C 10.51 16.33 11.17 17 12 17 C 12.83 17 13.5 16.33 13.5 15.5 C 13.5 14.67 12.83 14 12 14 Z"/>
                                    </StackPane>
                                    <Label text="1. Vender" styleClass="dashboard-module-title"/>
                                    <Label text="(Mostrador principal)" styleClass="dashboard-module-subtitle"/>
                                </VBox>
                            </StackPane>
                        </graphic>
                    </Button>

                    <!-- Modulo 2: Caja y cierre del dia -->
                    <Button fx:id="btnNavCaja" onAction="#mostrarCaja"
                            maxWidth="Infinity" maxHeight="Infinity"
                            styleClass="dashboard-module-card"
                            GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <graphic>
                            <VBox alignment="CENTER" spacing="6" prefWidth="340" prefHeight="150">
                                <StackPane styleClass="dashboard-module-icon-circle">
                                    <SVGPath fill="#704214" content="M 2 1 C 1.17 1 0.5 1.67 0.5 2.5 L 0.5 13.5 C 0.5 14.33 1.17 15 2 15 L 12 15 C 12.83 15 13.5 14.33 13.5 13.5 L 13.5 2.5 C 13.5 1.67 12.83 1 12 1 L 2 1 Z M 2.5 3 L 11.5 3 L 11.5 6 L 2.5 6 L 2.5 3 Z M 3.5 8 L 5.5 8 L 5.5 9.5 L 3.5 9.5 L 3.5 8 Z M 6 8 L 8 8 L 8 9.5 L 6 9.5 L 6 8 Z M 8.5 8 L 10.5 8 L 10.5 9.5 L 8.5 9.5 L 8.5 8 Z M 3.5 11 L 5.5 11 L 5.5 12.5 L 3.5 12.5 L 3.5 11 Z M 6 11 L 10.5 11 L 10.5 12.5 L 6 12.5 L 6 11 Z"/>
                                </StackPane>
                                <Label text="2. Caja y cierre del día" styleClass="dashboard-module-title"/>
                                <Label text="(Entradas y salidas)" styleClass="dashboard-module-subtitle"/>
                            </VBox>
                        </graphic>
                    </Button>

                    <!-- Modulo 3: Clientes y fiado -->
                    <Button fx:id="btnNavClientes" onAction="#mostrarClientes"
                            maxWidth="Infinity" maxHeight="Infinity"
                            styleClass="dashboard-module-card"
                            GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <graphic>
                            <VBox alignment="CENTER" spacing="6" prefWidth="340" prefHeight="150">
                                <StackPane styleClass="dashboard-module-icon-circle">
                                    <SVGPath fill="#704214" content="M 3 1 C 1.9 1 1 1.9 1 3 L 1 13 C 1 14.1 1.9 15 3 15 L 11 15 C 12.1 15 13 14.1 13 13 L 13 3 C 13 1.9 12.1 1 11 1 L 3 1 Z M 4 3 L 7 3 L 7 7 L 5.5 6 L 4 7 L 4 3 Z M 3.5 9.5 L 10.5 9.5 L 10.5 10.8 L 3.5 10.8 L 3.5 9.5 Z M 3.5 12 L 8.5 12 L 8.5 13.3 L 3.5 13.3 L 3.5 12 Z"/>
                                </StackPane>
                                <Label text="3. Clientes y fiado" styleClass="dashboard-module-title"/>
                                <Label text="(Cuentas de clientes)" styleClass="dashboard-module-subtitle"/>
                            </VBox>
                        </graphic>
                    </Button>

                    <!-- Modulo 4: Productos y precios -->
                    <Button fx:id="btnNavInventario" onAction="#mostrarInventario"
                            maxWidth="Infinity" maxHeight="Infinity"
                            styleClass="dashboard-module-card"
                            GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <graphic>
                            <VBox alignment="CENTER" spacing="6" prefWidth="340" prefHeight="150">
                                <StackPane styleClass="dashboard-module-icon-circle">
                                    <SVGPath fill="#704214" content="M 8.5 1 L 2.5 1 C 1.67 1 1 1.67 1 2.5 L 1 8.5 C 1 9.05 1.22 9.55 1.59 9.91 L 7.59 15.91 C 8.37 16.69 9.63 16.69 10.41 15.91 L 15.91 10.41 C 16.69 9.63 16.69 8.37 15.91 7.59 L 9.91 1.59 C 9.55 1.22 9.05 1 8.5 1 Z M 4.25 5.5 C 3.56 5.5 3 4.94 3 4.25 C 3 3.56 3.56 3 4.25 3 C 4.94 3 5.5 3.56 5.5 4.25 C 5.5 4.94 4.94 5.5 4.25 5.5 Z"/>
                                </StackPane>
                                <Label text="4. Productos y precios" styleClass="dashboard-module-title"/>
                                <Label text="(Ver y modificar)" styleClass="dashboard-module-subtitle"/>
                            </VBox>
                        </graphic>
                    </Button>

                    <!-- Modulo 5: Compras y proveedores -->
                    <Button fx:id="btnNavProveedores" onAction="#mostrarProveedores"
                            maxWidth="Infinity" maxHeight="Infinity"
                            styleClass="dashboard-module-card"
                            GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <graphic>
                            <VBox alignment="CENTER" spacing="6" prefWidth="340" prefHeight="150">
                                <StackPane styleClass="dashboard-module-icon-circle">
                                    <SVGPath fill="#704214" content="M 12.5 4.5 L 10 4.5 L 10 1.5 C 10 0.95 9.55 0.5 9 0.5 L 1 0.5 C 0.45 0.5 0 0.95 0 1.5 L 0 10.5 L 1.5 10.5 C 1.5 11.88 2.62 13 4 13 C 5.38 13 6.5 11.88 6.5 10.5 L 10.5 10.5 C 10.5 11.88 11.62 13 13 13 C 14.38 13 15.5 11.88 15.5 10.5 L 17 10.5 L 17 7.5 L 12.5 4.5 Z M 4 11.75 C 3.31 11.75 2.75 11.19 2.75 10.5 C 2.75 9.81 3.31 9.25 4 9.25 C 4.69 9.25 5.25 9.81 5.25 10.5 C 5.25 11.19 4.69 11.75 4 11.75 Z M 13 11.75 C 12.31 11.75 11.75 11.19 11.75 10.5 C 11.75 9.81 12.31 9.25 13 9.25 C 13.69 9.25 14.25 9.81 14.25 10.5 C 14.25 11.19 13.69 11.75 13 11.75 Z M 10 8 L 10 5.75 L 12.1 5.75 L 15.4 8 L 10 8 Z"/>
                                </StackPane>
                                <Label text="5. Compras y proveedores" styleClass="dashboard-module-title"/>
                                <Label text="(Pedidos y pagos)" styleClass="dashboard-module-subtitle"/>
                            </VBox>
                        </graphic>
                    </Button>

                    <!-- Modulo 6: Reportes -->
                    <Button fx:id="btnNavReportes" onAction="#mostrarReportes"
                            maxWidth="Infinity" maxHeight="Infinity"
                            styleClass="dashboard-module-card"
                            GridPane.columnIndex="2" GridPane.rowIndex="1">
                        <graphic>
                            <VBox alignment="CENTER" spacing="6" prefWidth="340" prefHeight="150">
                                <StackPane styleClass="dashboard-module-icon-circle">
                                    <SVGPath fill="#704214" content="M 7 0.5 L 1 3.2 L 1 7.2 C 1 10.9 3.56 14.36 7 15.2 C 10.44 14.36 13 10.9 13 7.2 L 13 3.2 L 7 0.5 Z M 5.67 11.2 L 3 8.53 L 3.94 7.59 L 5.67 9.31 L 10.06 4.92 L 11 5.87 L 5.67 11.2 Z"/>
                                </StackPane>
                                <Label text="6. Reportes" styleClass="dashboard-module-title"/>
                                <Label text="(Ventas, inventario y deudas)" styleClass="dashboard-module-subtitle"/>
                            </VBox>
                        </graphic>
                    </Button>
                </GridPane>

                <!-- FILA 4: 3 TARJETAS DE ALERTAS RAPIDAS -->
                <GridPane hgap="14">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="33.34" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                    </columnConstraints>

                    <!-- Alerta 1: Stock Bajo -->
                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="dashboard-alert-card"
                          GridPane.columnIndex="0">
                        <Circle radius="4.5" fill="#B56A27"/>
                        <Label fx:id="lblAlertaStock" text="0 productos con pocas existencias"
                               styleClass="dashboard-alert-text" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button text="Ver" onAction="#mostrarInventario" styleClass="dashboard-btn-outline"/>
                    </HBox>

                    <!-- Alerta 2: Pagos a Proveedores -->
                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="dashboard-alert-card"
                          GridPane.columnIndex="1">
                        <Circle radius="4.5" fill="#B56A27"/>
                        <Label fx:id="lblAlertaProveedores" text="0 pagos a proveedor vencen esta semana"
                               styleClass="dashboard-alert-text" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button text="Ver" onAction="#mostrarProveedores" styleClass="dashboard-btn-outline"/>
                    </HBox>

                    <!-- Alerta 3: Clientes con Deuda -->
                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="dashboard-alert-card"
                          GridPane.columnIndex="2">
                        <Circle radius="4.5" fill="#B56A27"/>
                        <Label fx:id="lblAlertaFiados" text="0 clientes con deuda vencida"
                               styleClass="dashboard-alert-text" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button text="Ver" onAction="#mostrarClientes" styleClass="dashboard-btn-outline"/>
                    </HBox>
                </GridPane>

                <!-- FILA 5: BARRA DE ESTADO DE CAJA Y RESPALDO -->
                <HBox alignment="CENTER_LEFT" spacing="14" styleClass="dashboard-row-card">
                    <Label fx:id="lblIconoCaja" text="✓" styleClass="dashboard-caja-icon-ok"/>

                    <VBox alignment="CENTER_LEFT" spacing="1">
                        <Label fx:id="lblEstadoCaja" text="✓ Caja del día: ABIERTA Y LISTA PARA COBRAR"
                               styleClass="dashboard-caja-title"/>
                        <Label fx:id="lblDetalleCaja" text="Fondo base inicial registrado: $ 50.000 (Apertura: 08:15 AM)"
                               styleClass="dashboard-caja-detail"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <!-- Capsula de Ultima Copia de Seguridad -->
                    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="dashboard-backup-pill">
                        <SVGPath fill="transparent" stroke="#704214" strokeWidth="1.4"
                                 content="M 6 0.5 L 1 2.8 L 1 6.2 C 1 9.4 3.1 12.3 6 13 C 8.9 12.3 11 9.4 11 6.2 L 11 2.8 L 6 0.5 Z M 4.8 9.2 L 2.8 7.2 L 3.6 6.4 L 4.8 7.6 L 8.4 4 L 9.2 4.8 L 4.8 9.2 Z"/>
                        <Label fx:id="lblUltimoRespaldo" text="Última copia de seguridad: hoy, 10:00 p. m."
                               styleClass="dashboard-backup-text"/>
                    </HBox>

                    <Button fx:id="btnMasOpciones" text="Más opciones" onAction="#handleMasOpcionesRespaldo"
                            styleClass="dashboard-link-btn"/>
                </HBox>

                <!-- FILA 6: PIE DE AYUDA -->
                <HBox alignment="CENTER_LEFT" spacing="14" styleClass="dashboard-row-card">
                    <Label text="?" styleClass="dashboard-help-icon"/>
                    <Label text="¿Necesita ayuda con el sistema? Pídasela a Gladys en el mostrador o abra el manual."
                           styleClass="dashboard-help-text"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Manual sencillo" onAction="#handleManualSencillo"
                            styleClass="dashboard-btn-outline"/>
                </HBox>

            </VBox>

        </StackPane>
    </center>

</BorderPane>
