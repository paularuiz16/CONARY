<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<StackPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.conary.rosita.controller.AutorizarFiadoController"
           styleClass="modal-abono-root">

    <VBox spacing="14" prefWidth="480" maxWidth="480" styleClass="modal-abono-card">

        <!-- Cabecera dinamica: "Autorizar fiado" o "Cambiar cupo de fiado" -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <StackPane styleClass="modal-abono-icon-box">
                <SVGPath fill="transparent" stroke="#704214" strokeWidth="1.6"
                         content="M 1 2.5 C 3 1.5 5.5 1.5 7.5 2.8 C 9.5 1.5 12 1.5 14 2.5 L 14 12.5 C 12 11.5 9.5 11.5 7.5 12.8 C 5.5 11.5 3 11.5 1 12.5 Z M 7.5 2.8 L 7.5 12.8"/>
            </StackPane>
            <VBox spacing="2">
                <Label fx:id="lblTitulo" text="Autorizar fiado" styleClass="modal-abono-title"/>
                <Label fx:id="lblSubtitulo" text="Defina el cupo de crédito disponible para este cliente"
                       styleClass="modal-fiado-subtitle"/>
            </VBox>
        </HBox>

        <!-- Tarjeta Resumen del Cliente -->
        <VBox spacing="6" styleClass="modal-abono-client-card">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label fx:id="lblResumenNombre" text="Luisa Rojas · 312 555 0113"
                       styleClass="modal-abono-client-name"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblResumenDerecha" text="Cliente Registrado"
                       styleClass="modal-fiado-pill-registrado"/>
            </HBox>
            <Label fx:id="lblResumenDetalle" text="Todavía no tiene fiado. Hoy debe \$ 0."
                   wrapText="true" styleClass="modal-fiado-detalle"/>
        </VBox>

        <!-- Alerta ambar de validacion -->
        <HBox fx:id="boxAlertaCupo" alignment="CENTER_LEFT" spacing="8"
              visible="false" managed="false" styleClass="modal-abono-alert">
            <Label fx:id="lblAlertaCupo" text="⚠  Escriba un valor mayor a cero para activar el cupo."
                   wrapText="true" styleClass="modal-abono-alert-text"/>
        </HBox>

        <!-- Campo de Cupo -->
        <VBox spacing="5">
            <Label text="¿Hasta cuánto le puede fiar?" styleClass="modal-abono-field-label"/>
            <Label text="Es lo máximo que podrá deber a la vez en la papelería" styleClass="modal-abono-field-help"/>
            <HBox fx:id="boxInputCupo" alignment="CENTER_LEFT" spacing="6" styleClass="modal-abono-input-box">
                <Label text="\$" styleClass="modal-abono-input-prefix"/>
                <TextField fx:id="txtCupoFiado" promptText="0"
                           HBox.hgrow="ALWAYS" styleClass="modal-abono-input-field"/>
            </HBox>
        </VBox>

        <!-- Franja de confirmacion -->
        <HBox fx:id="boxConfirmacionCupo" alignment="CENTER_LEFT" spacing="8" styleClass="modal-fiado-confirm-box">
            <Label fx:id="lblConfirmacionCupo" text="✓  Podrá deber hasta \$ 0."
                   wrapText="true" styleClass="modal-fiado-confirm-text"/>
        </HBox>

        <!-- Quitar el fiado (solo en modo Cambiar cupo) -->
        <HBox fx:id="boxQuitarFiado" alignment="CENTER_LEFT" spacing="10" visible="false" managed="false">
            <Button fx:id="btnQuitarFiado" text="⊘   Quitar el fiado" onAction="#handleQuitarFiado"
                    styleClass="modal-fiado-btn-quitar"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Ya no se le podrá fiar. Su deuda actual se conserva."
                   wrapText="true" maxWidth="230" styleClass="modal-fiado-quitar-note"/>
        </HBox>

        <!-- Botones Inferiores -->
        <HBox alignment="CENTER_RIGHT" spacing="12">
            <VBox.margin>
                <Insets top="2"/>
            </VBox.margin>
            <Button fx:id="btnCancelar" text="✕   Cancelar" onAction="#handleCancelar"
                    styleClass="modal-fiado-btn-cancel"/>
            <Button fx:id="btnGuardarCupo" text="✓   Autorizar fiado" onAction="#handleGuardarCupo"
                    styleClass="modal-abono-btn-save"/>
        </HBox>
    </VBox>
</StackPane>
