<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.conary.rosita.controller.VentasHoyController"
            fx:id="rootPane"
            styleClass="ventas-hoy-root"
            maxWidth="Infinity" maxHeight="Infinity">

    <!-- ==================================================================
         ENCABEZADO SUPERIOR DE VENTAS DE HOY
         ================================================================== -->
    <top>
        <VBox spacing="0">
            <padding>
                <Insets top="10" right="18" bottom="8" left="18"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="14" styleClass="ventas-hoy-header-bar">
                <Button fx:id="btnVolverVender" text="←   Volver a Vender"
                        onAction="#handleVolverAVender"
                        styleClass="ventas-hoy-btn-volver"/>

                <StackPane styleClass="ventas-hoy-header-icon-box">
                    <SVGPath fill="transparent" stroke="#704214" strokeWidth="1.6"
                             content="M 1 2.5 C 3 1.5 5.5 1.5 7.5 2.8 C 9.5 1.5 12 1.5 14 2.5 L 14 12.5 C 12 11.5 9.5 11.5 7.5 12.8 C 5.5 11.5 3 11.5 1 12.5 Z M 7.5 2.8 L 7.5 12.8"/>
                </StackPane>

                <VBox alignment="CENTER_LEFT" spacing="1">
                    <Label text="Ventas de hoy" styleClass="ventas-hoy-header-title"/>
                    <Label fx:id="lblFechaHoyHeader" text="Domingo, 15 de noviembre de 2026"
                           styleClass="ventas-hoy-header-date"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Insignia de Estado de Caja -->
                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="ventas-hoy-caja-pill">
                    <Circle fx:id="circleEstadoCaja" radius="4.5" fill="#1E7B42"/>
                    <Label fx:id="lblEstadoCaja" text="Caja abierta" styleClass="ventas-hoy-caja-text"/>
                </HBox>

                <!-- Capsula de Usuario en Sesion Real -->
                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="ventas-hoy-user-pill">
                    <StackPane>
                        <Circle radius="12" fill="transparent" stroke="#704214" strokeWidth="1.5"/>
                        <SVGPath fill="#704214"
                                 content="M 0 -4 C -1.8 -4 -3.2 -2.6 -3.2 -0.8 C -3.2 1 -1.8 2.4 0 2.4 C 1.8 2.4 3.2 1 3.2 -0.8 C 3.2 -2.6 1.8 -4 0 -4 Z M 0 4 C -2.8 4 -5.6 5.4 -5.6 7.6 L 5.6 7.6 C 5.6 5.4 2.8 4 0 4 Z"/>
                    </StackPane>
                    <Label fx:id="lblUsuarioNombre" text="Doña Rosita" styleClass="ventas-hoy-user-name"/>
                    <Label fx:id="lblUsuarioRolBadge" text="ADMINISTRADORA" styleClass="ventas-hoy-user-badge"/>
                </HBox>
            </HBox>
        </VBox>
    </top>

    <!-- ==================================================================
         CONTENIDO CENTRAL: 3 TARJETAS DE RESUMEN, FILTROS Y TABLA
         ================================================================== -->
    <center>
        <VBox spacing="12" VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="2" right="18" bottom="8" left="18"/>
            </padding>

            <!-- 1. 3 Tarjetas Superiores de Resumen del Dia -->
            <HBox alignment="CENTER_LEFT" spacing="18" styleClass="ventas-hoy-summary-strip">
                <!-- Tarjeta 1: Actividad del dia -->
                <HBox alignment="CENTER_LEFT" spacing="12" HBox.hgrow="ALWAYS">
                    <StackPane styleClass="ventas-hoy-stat-icon-peach">
                        <SVGPath fill="transparent" stroke="#704214" strokeWidth="1.6"
                                 content="M 3 5 L 13 5 L 12 14 L 4 14 Z M 5.5 5 L 5.5 3.5 C 5.5 2.1 6.6 1 8 1 C 9.4 1 10.5 2.1 10.5 3.5 L 10.5 5"/>
                    </StackPane>
                    <VBox spacing="1">
                        <Label text="ACTIVIDAD DEL DÍA" styleClass="ventas-hoy-stat-kicker"/>
                        <Label fx:id="lblActividadDia" text="0 ventas" styleClass="ventas-hoy-stat-value-brown"/>
                    </VBox>
                </HBox>

                <Separator orientation="VERTICAL" prefHeight="42"/>

                <!-- Tarjeta 2: Dinero en caja -->
                <HBox alignment="CENTER_LEFT" spacing="12" HBox.hgrow="ALWAYS">
                    <StackPane styleClass="ventas-hoy-stat-icon-green">
                        <SVGPath fill="transparent" stroke="#1E6B38" strokeWidth="1.6"
                                 content="M 1 3 L 15 3 L 15 12 L 1 12 Z M 8 5.5 C 6.9 5.5 6 6.4 6 7.5 C 6 8.6 6.9 9.5 8 9.5 C 9.1 9.5 10 8.6 10 7.5 C 10 6.4 9.1 5.5 8 5.5 Z"/>
                    </StackPane>
                    <VBox spacing="1">
                        <Label text="DINERO EN CAJA" styleClass="ventas-hoy-stat-kicker"/>
                        <Label fx:id="lblDineroEnCaja" text="Entró a la caja $ 0" styleClass="ventas-hoy-stat-value-green"/>
                    </VBox>
                </HBox>

                <Separator orientation="VERTICAL" prefHeight="42"/>

                <!-- Tarjeta 3: Pendiente por cobrar -->
                <HBox alignment="CENTER_LEFT" spacing="12" HBox.hgrow="ALWAYS">
                    <StackPane styleClass="ventas-hoy-stat-icon-amber">
                        <SVGPath fill="transparent" stroke="#8F4714" strokeWidth="1.6"
                                 content="M 2 1 L 12 1 L 12 14 L 2 14 Z M 4.5 4.5 L 9.5 4.5 M 4.5 7.5 L 9.5 7.5 M 4.5 10.5 L 7.5 10.5"/>
                    </StackPane>
                    <VBox spacing="1">
                        <Label text="PENDIENTE POR COBRAR" styleClass="ventas-hoy-stat-kicker"/>
                        <Label fx:id="lblPendienteFiado" text="Quedó a fiado $ 0" styleClass="ventas-hoy-stat-value-amber"/>
                    </VBox>
                </HBox>
            </HBox>

            <!-- 2. Barra de Filtros y Busqueda -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <ToggleButton fx:id="tbFiltroTodas" text="Todas" selected="true"
                              styleClass="ventas-hoy-filter-pill"/>
                <ToggleButton fx:id="tbFiltroContado" text="De contado"
                              styleClass="ventas-hoy-filter-pill"/>
                <ToggleButton fx:id="tbFiltroFiado" text="A fiado"
                              styleClass="ventas-hoy-filter-pill"/>
                <ToggleButton fx:id="tbFiltroAnuladas" text="Anuladas"
                              styleClass="ventas-hoy-filter-pill"/>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="ventas-hoy-search-box">
                    <SVGPath fill="transparent" stroke="#7A5B43" strokeWidth="1.6"
                             content="M 6 1 C 3.24 1 1 3.24 1 6 C 1 8.76 3.24 11 6 11 C 8.76 11 11 8.76 11 6 C 11 3.24 8.76 1 6 1 Z M 9.8 9.8 L 13.5 13.5"/>
                    <TextField fx:id="txtBuscarVenta" promptText="Buscar por cliente o producto"
                               prefWidth="290" styleClass="ventas-hoy-search-input"/>
                </HBox>
            </HBox>

            <!-- 3. Tabla Principal de Ventas de Hoy -->
            <TableView fx:id="tblVentasHoy" VBox.vgrow="ALWAYS" styleClass="ventas-hoy-table">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colHora" text="HORA" prefWidth="95" minWidth="80" maxWidth="115"/>
                    <TableColumn fx:id="colQueSeVendio" text="QUÉ SE VENDIÓ" prefWidth="360" minWidth="240"/>
                    <TableColumn fx:id="colCliente" text="CLIENTE" prefWidth="190" minWidth="140" maxWidth="240"/>
                    <TableColumn fx:id="colPago" text="PAGO" prefWidth="120" minWidth="100" maxWidth="145"/>
                    <TableColumn fx:id="colTotal" text="TOTAL" prefWidth="135" minWidth="110" maxWidth="165"/>
                    <TableColumn fx:id="colEstado" text="ESTADO" prefWidth="150" minWidth="125" maxWidth="180"/>
                </columns>
                <placeholder>
                    <VBox alignment="CENTER" spacing="6" style="-fx-padding: 32;">
                        <Label text="No hay ventas registradas para el filtro seleccionado."
                               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #6B4C35;"/>
                        <Label text="Las ventas que registre hoy en el mostrador aparecerán aquí."
                               style="-fx-font-size: 13px; -fx-text-fill: #8D7B6A;"/>
                    </VBox>
                </placeholder>
            </TableView>

        </VBox>
    </center>

    <!-- ==================================================================
         BARRA INFERIOR FIJA DE SELECCION Y ACCIONES (COMPROBANTE / ANULAR)
         ================================================================== -->
    <bottom>
        <VBox spacing="0">
            <padding>
                <Insets top="2" right="18" bottom="12" left="18"/>
            </padding>

            <HBox fx:id="barraSeleccionVenta" alignment="CENTER_LEFT" spacing="12"
                  styleClass="ventas-hoy-selection-bar">
                <Label text="ⓘ" style="-fx-font-size: 15px; -fx-text-fill: #704214; -fx-font-weight: bold;"/>

                <Label fx:id="lblVentaSeleccionadaInfo"
                       text="Seleccione una venta de la tabla para ver sus opciones"
                       styleClass="ventas-hoy-selection-text"
                       HBox.hgrow="ALWAYS" maxWidth="Infinity"/>

                <Button fx:id="btnEmitirComprobante" text="🧾   Emitir comprobante"
                        onAction="#handleEmitirComprobante"
                        styleClass="ventas-hoy-btn-comprobante"/>

                <Button fx:id="btnAnularVenta" text="⊗   Anular venta"
                        onAction="#handleAnularVenta"
                        styleClass="ventas-hoy-btn-anular"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
