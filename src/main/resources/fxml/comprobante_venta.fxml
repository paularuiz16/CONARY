<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.conary.rosita.controller.ComprobanteVentaController"
            fx:id="rootPane"
            styleClass="comprobante-root"
            maxWidth="Infinity" maxHeight="Infinity">

    <!-- ==================================================================
         ENCABEZADO SUPERIOR DE COMPROBANTE DE VENTA
         ================================================================== -->
    <top>
        <VBox spacing="0">
            <padding>
                <Insets top="10" right="20" bottom="8" left="20"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="14" styleClass="comprobante-header-bar">
                <Button fx:id="btnVolverTop" text="←   Volver a Ventas de hoy"
                        onAction="#handleVolverVentasHoy"
                        styleClass="comprobante-btn-volver-top"/>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox alignment="CENTER" spacing="12">
                    <StackPane styleClass="comprobante-header-icon-box">
                        <SVGPath fill="transparent" stroke="#8C4A27" strokeWidth="1.6"
                                 content="M 2 1 L 10 1 L 13 4 L 13 15 L 2 15 Z M 9.5 1 L 9.5 4.5 L 13 4.5 M 4.5 8 L 10.5 8 M 4.5 11 L 8.5 11"/>
                    </StackPane>
                    <VBox alignment="CENTER_LEFT" spacing="1">
                        <Label text="Comprobante de venta" styleClass="comprobante-header-title"/>
                        <Label fx:id="lblFechaHeader" text="Domingo, 15 de noviembre de 2026"
                               styleClass="comprobante-header-date"/>
                    </VBox>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Capsula de Usuario en Sesion Real -->
                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="ventas-hoy-user-pill">
                    <StackPane>
                        <Circle radius="12" fill="transparent" stroke="#704214" strokeWidth="1.5"/>
                        <SVGPath fill="#704214"
                                 content="M 0 -4 C -1.8 -4 -3.2 -2.6 -3.2 -0.8 C -3.2 1 -1.8 2.4 0 2.4 C 1.8 2.4 3.2 1 3.2 -0.8 C 3.2 -2.6 1.8 -4 0 -4 Z M 0 4 C -2.8 4 -5.6 5.4 -5.6 7.6 L 5.6 7.6 C 5.6 5.4 2.8 4 0 4 Z"/>
                    </StackPane>
                    <Label fx:id="lblUsuarioNombre" text="Doña Rosita" styleClass="ventas-hoy-user-name"/>
                    <Label fx:id="lblUsuarioRolBadge" text="ADMINISTRADORA" styleClass="ventas-hoy-user-badge"/>
                </HBox>
            </HBox>
        </VBox>
    </top>

    <!-- ==================================================================
         CUERPO PRINCIPAL: 2 COLUMNAS (DATOS OPCIONALES + VISTA PREVIA)
         ================================================================== -->
    <center>
        <HBox spacing="16" maxWidth="Infinity" maxHeight="Infinity">
            <padding>
                <Insets top="2" right="20" bottom="14" left="20"/>
            </padding>

            <!-- ==========================================================
                 COLUMNA IZQUIERDA: 1. DATOS DEL CLIENTE (OPCIONAL)
                 ========================================================== -->
            <VBox spacing="12" prefWidth="445" minWidth="420" maxWidth="470"
                  styleClass="comprobante-left-card">

                <HBox alignment="TOP_LEFT" spacing="10">
                    <StackPane styleClass="comprobante-section-icon">
                        <SVGPath fill="#5C300C"
                                 content="M 0 -5 C -2.2 -5 -4 -3.2 -4 -1 C -4 1.2 -2.2 3 0 3 C 2.2 3 4 1.2 4 -1 C 4 -3.2 2.2 -5 0 -5 Z M 0 4.5 C -3.5 4.5 -7 6.3 -7 9 L 7 9 C 7 6.3 3.5 4.5 0 4.5 Z"/>
                    </StackPane>
                    <VBox spacing="2">
                        <Label text="1. Datos del cliente (opcional)" styleClass="comprobante-section-title"/>
                        <Label text="Si el cliente necesita sus datos en el comprobante, anótelos aquí."
                               wrapText="true" maxWidth="360"
                               styleClass="comprobante-section-subtitle"/>
                    </VBox>
                </HBox>

                <!-- Campo 1: Nombre completo o razon social -->
                <VBox spacing="5">
                    <Label text="Nombre completo o razón social" styleClass="comprobante-field-label"/>
                    <TextField fx:id="txtNombreClienteComprobante"
                               promptText="Déjelo vacío para 'Público'"
                               styleClass="comprobante-input"/>
                </VBox>

                <!-- Campo 2: Cedula o NIT -->
                <VBox spacing="5">
                    <Label text="Cédula o NIT" styleClass="comprobante-field-label"/>
                    <TextField fx:id="txtCedulaNit"
                               promptText="Número de identificación (opcional)"
                               styleClass="comprobante-input"/>
                </VBox>

                <!-- Campo 3: Numero de factura externa -->
                <VBox spacing="5">
                    <Label text="Número de factura (si la hizo por otro medio)" styleClass="comprobante-field-label"/>
                    <TextField fx:id="txtNumeroFacturaExterna"
                               promptText="Número de factura (opcional)"
                               styleClass="comprobante-input"/>
                    <Label text="Solo para anotarlo. El sistema no emite facturas."
                           styleClass="comprobante-field-help"/>
                </VBox>

                <!-- Tarjeta Resumen de Venta Seleccionada -->
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="comprobante-venta-resumen-box">
                    <StackPane styleClass="comprobante-venta-resumen-icon">
                        <SVGPath fill="transparent" stroke="#704214" strokeWidth="1.5"
                                 content="M 1 2 L 3 2 L 5 9 L 12 9 L 13.5 4 L 4 4 M 5.5 11.5 C 5.5 12.1 5.1 12.5 4.5 12.5 C 3.9 12.5 3.5 12.1 3.5 11.5 M 11.5 11.5 C 11.5 12.1 11.1 12.5 10.5 12.5 C 9.9 12.5 9.5 12.1 9.5 11.5"/>
                    </StackPane>
                    <VBox spacing="2">
                        <Label fx:id="lblResumenVentaHoraTotal"
                               text="Venta de las 10:42 · $ 12.600"
                               styleClass="comprobante-venta-resumen-main"/>
                        <Label fx:id="lblResumenVentaItemsModo"
                               text="2 productos cobrados en mostrador (Contado)."
                               styleClass="comprobante-venta-resumen-sub"/>
                    </VBox>
                </HBox>

                <Region VBox.vgrow="ALWAYS"/>

                <!-- Botones Inferiores Apilados -->
                <VBox spacing="10">
                    <Button fx:id="btnGenerarComprobante" text="📄   Generar comprobante"
                            onAction="#handleGenerarComprobante"
                            maxWidth="Infinity" styleClass="comprobante-btn-primary"/>

                    <Button fx:id="btnVolverInferior" text="←   Volver"
                            onAction="#handleVolverVentasHoy"
                            maxWidth="Infinity" styleClass="comprobante-btn-secondary"/>
                </VBox>
            </VBox>

            <!-- ==========================================================
                 COLUMNA DERECHA: 2. ASI QUEDARA EL COMPROBANTE (VISTA PREVIA)
                 ========================================================== -->
            <VBox spacing="12" HBox.hgrow="ALWAYS" maxWidth="Infinity" maxHeight="Infinity"
                  styleClass="comprobante-right-card">

                <HBox alignment="TOP_LEFT" spacing="10">
                    <StackPane styleClass="comprobante-section-icon">
                        <SVGPath fill="transparent" stroke="#5C300C" strokeWidth="1.6"
                                 content="M 1 6 C 3.2 2.5 6 1 9 1 C 12 1 14.8 2.5 17 6 C 14.8 9.5 12 11 9 11 C 6 11 3.2 9.5 1 6 Z M 9 4 C 7.9 4 7 4.9 7 6 C 7 7.1 7.9 8 9 8 C 10.1 8 11 7.1 11 6 C 11 4.9 10.1 4 9 4 Z"/>
                    </StackPane>
                    <VBox spacing="2">
                        <Label text="2. Así quedará el comprobante" styleClass="comprobante-section-title"/>
                        <Label text="Vista previa en tiempo real antes de guardar."
                               styleClass="comprobante-section-subtitle"/>
                    </VBox>
                </HBox>

                <!-- Tarjeta Blanca Tipo Recibo Interno -->
                <VBox spacing="10" VBox.vgrow="ALWAYS" styleClass="comprobante-receipt-box">

                    <!-- Encabezado centrado del recibo -->
                    <VBox alignment="CENTER" spacing="6">
                        <Label text="Papelería de Rosita" styleClass="comprobante-receipt-store-title"/>
                        <Label fx:id="lblNumeroComprobantePill"
                               text="Comprobante No. 0001"
                               styleClass="comprobante-receipt-number-pill"/>
                        <Label fx:id="lblFechaHoraVentaRecibo"
                               text="24 de octubre de 2026 · 10:42 a. m."
                               styleClass="comprobante-receipt-datetime"/>
                    </VBox>

                    <Separator/>

                    <!-- Linea de Cliente en tiempo real -->
                    <VBox spacing="3">
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="Cliente:" styleClass="comprobante-receipt-client-prefix"/>
                            <Label fx:id="lblClienteEnVivo" text="Público"
                                   wrapText="true" styleClass="comprobante-receipt-client-value"/>
                        </HBox>
                        <Label fx:id="lblFacturaExternaEnVivo"
                               text="" visible="false" managed="false"
                               styleClass="comprobante-receipt-meta-extra"/>
                    </VBox>

                    <Separator/>

                    <!-- Desglose de todos los items reales de la venta -->
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                                VBox.vgrow="ALWAYS" styleClass="vender-scroll-clean">
                        <content>
                            <VBox fx:id="boxItemsComprobante" spacing="10">
                                <padding>
                                    <Insets top="4" right="2" bottom="4" left="2"/>
                                </padding>
                            </VBox>
                        </content>
                    </ScrollPane>

                    <!-- Franja inferior de Total -->
                    <HBox alignment="CENTER_LEFT" styleClass="comprobante-receipt-total-bar">
                        <Label text="Total" styleClass="comprobante-receipt-total-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblTotalRecibo" text="\$ 12.600" styleClass="comprobante-receipt-total-amount"/>
                    </HBox>

                    <!-- Leyenda legal obligatoria -->
                    <Label text="Documento interno de la papelería. No es factura de venta."
                           alignment="CENTER" maxWidth="Infinity"
                           styleClass="comprobante-receipt-legal-note"/>
                </VBox>

            </VBox>

        </HBox>
    </center>

</BorderPane>
