<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.conary.rosita.controller.VentaRegistradaController"
            fx:id="rootPane"
            styleClass="vender-root"
            maxWidth="Infinity" maxHeight="Infinity">

    <!-- ==================================================================
         ENCABEZADO SUPERIOR DE VENDER
         ================================================================== -->
    <top>
        <VBox spacing="0">
            <padding>
                <Insets top="10" right="18" bottom="8" left="18"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="vender-header-bar">
                <Button fx:id="btnVolverMenu" text="←  Volver al Menú" onAction="#handleVolverMenu"
                        styleClass="vender-btn-volver"/>

                <Separator orientation="VERTICAL" prefHeight="28"/>

                <StackPane styleClass="vender-header-icon-box">
                    <SVGPath fill="transparent" stroke="#704214" strokeWidth="1.6"
                             content="M 1 5 L 2.5 1.5 L 13.5 1.5 L 15 5 Z M 2 5 L 2 14 L 14 14 L 14 5 M 6 14 L 6 9 L 10 9 L 10 14"/>
                </StackPane>

                <VBox alignment="CENTER_LEFT" spacing="1">
                    <Label text="Vender" styleClass="vender-header-title"/>
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <Circle radius="4" fill="#1E7B42"/>
                        <Label text="Caja abierta" styleClass="vender-header-caja-status"/>
                    </HBox>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="btnHistorialHoyHeader" text="🧾   Historial de hoy"
                        onAction="#handleIrAVentasHoy"
                        styleClass="vender-btn-historial"/>

                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="vender-user-pill">
                    <StackPane>
                        <Circle radius="12" fill="transparent" stroke="#704214" strokeWidth="1.5"/>
                        <SVGPath fill="#704214"
                                 content="M 0 -4 C -1.8 -4 -3.2 -2.6 -3.2 -0.8 C -3.2 1 -1.8 2.4 0 2.4 C 1.8 2.4 3.2 1 3.2 -0.8 C 3.2 -2.6 1.8 -4 0 -4 Z M 0 4 C -2.8 4 -5.6 5.4 -5.6 7.6 L 5.6 7.6 C 5.6 5.4 2.8 4 0 4 Z"/>
                    </StackPane>
                    <Label fx:id="lblUsuarioNombre" text="Doña Rosita" styleClass="vender-user-name"/>
                    <Label fx:id="lblUsuarioRolBadge" text="ADMIN" styleClass="vender-user-badge"/>
                </HBox>
            </HBox>
        </VBox>
    </top>

    <!-- ==================================================================
         TARJETA CENTRAL: "¡VENTA REGISTRADA!"
         ================================================================== -->
    <center>
        <StackPane maxWidth="Infinity" maxHeight="Infinity">
            <padding>
                <Insets top="8" right="24" bottom="14" left="24"/>
            </padding>

            <VBox alignment="TOP_CENTER" spacing="14" maxWidth="530" maxHeight="-Infinity"
                  styleClass="venta-reg-card">

                <!-- Icono circular verde suave con check -->
                <StackPane minWidth="58" minHeight="58" maxWidth="58" maxHeight="58"
                           styleClass="venta-reg-check-circle">
                    <SVGPath fill="transparent" stroke="#18864B" strokeWidth="2.8"
                             content="M -8 0.5 L -2.5 6 L 9 -5.5"/>
                </StackPane>

                <VBox alignment="CENTER" spacing="3">
                    <Label text="¡Venta registrada!" styleClass="venta-reg-title"/>
                    <Label fx:id="lblSubtituloHoraProductos"
                           text="10:42 a. m. · 2 productos"
                           styleClass="venta-reg-subtitle"/>
                </VBox>

                <Separator/>

                <!-- Lista desglosada de items vendidos -->
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                            maxHeight="155" styleClass="vender-scroll-clean">
                    <content>
                        <VBox fx:id="boxDetalleItems" spacing="8">
                            <padding>
                                <Insets top="2" right="2" bottom="2" left="2"/>
                            </padding>
                        </VBox>
                    </content>
                </ScrollPane>

                <Separator/>

                <!-- Fila Total -->
                <HBox alignment="CENTER_LEFT">
                    <Label text="Total" styleClass="venta-reg-total-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblTotalVenta" text="\$ 12.600" styleClass="venta-reg-total-value"/>
                </HBox>

                <!-- Bloque Dinamico 1: Venta de Contado -->
                <VBox fx:id="boxResumenContado" spacing="12" visible="true" managed="true">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Recibido" styleClass="venta-reg-total-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblValorRecibido" text="\$ 20.000" styleClass="venta-reg-recibido-value"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="venta-reg-cambio-box">
                        <Label text="🔄   Cambio a devolver" styleClass="venta-reg-cambio-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblCambioDevolver" text="\$ 7.400" styleClass="venta-reg-cambio-value"/>
                    </HBox>

                    <HBox alignment="CENTER" spacing="6">
                        <StackPane minWidth="16" minHeight="16" maxWidth="16" maxHeight="16"
                                   styleClass="venta-reg-mini-check">
                            <Label text="✓" style="-fx-text-fill: #FFFFFF; -fx-font-size: 9px; -fx-font-weight: bold;"/>
                        </StackPane>
                        <Label text="Se guardó en la caja del día." styleClass="venta-reg-saved-note"/>
                    </HBox>
                </VBox>

                <!-- Bloque Dinamico 2: Venta a Fiado -->
                <VBox fx:id="boxResumenFiado" spacing="12" visible="false" managed="false">
                    <VBox spacing="6" styleClass="venta-reg-cambio-box">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="👤   Cliente:" styleClass="venta-reg-cambio-label"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblClienteFiado" text="María Gómez" styleClass="venta-reg-recibido-value"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Nuevo saldo adeudado en cuenta:" styleClass="venta-reg-total-label"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblNuevoSaldoFiado" text="\$ 32.600" styleClass="venta-reg-cambio-value"/>
                        </HBox>
                    </VBox>

                    <HBox alignment="CENTER" spacing="6">
                        <StackPane minWidth="16" minHeight="16" maxWidth="16" maxHeight="16"
                                   styleClass="venta-reg-mini-check">
                            <Label text="✓" style="-fx-text-fill: #FFFFFF; -fx-font-size: 9px; -fx-font-weight: bold;"/>
                        </StackPane>
                        <Label text="Se cargó a la cuenta de fiado del cliente." styleClass="venta-reg-saved-note"/>
                    </HBox>
                </VBox>

                <!-- Botones Inferiores Apilados -->
                <VBox spacing="10">
                    <VBox.margin>
                        <Insets top="2"/>
                    </VBox.margin>

                    <Button fx:id="btnNuevaVenta" text="＋   Nueva venta"
                            onAction="#handleNuevaVenta"
                            maxWidth="Infinity" styleClass="venta-reg-btn-primary"/>

                    <Button fx:id="btnVentasHoy" text="📖   Ventas de hoy"
                            onAction="#handleIrAVentasHoy"
                            maxWidth="Infinity" styleClass="venta-reg-btn-secondary"/>
                </VBox>

            </VBox>
        </StackPane>
    </center>

</BorderPane>
