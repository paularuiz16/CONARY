<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.conary.rosita.controller.LoginController"
           styleClass="login-bg"
           stylesheets="@../css/styles.css"
           prefWidth="680" prefHeight="660">

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <!-- Tarjeta Central de Login -->
    <VBox alignment="TOP_CENTER" spacing="18" maxWidth="410" maxHeight="-Infinity"
          styleClass="login-card">

        <!-- Cabecera: Logo + Titulo + Subtitulo + Separador -->
        <VBox alignment="CENTER" spacing="6">
            <ImageView fitHeight="76.0" preserveRatio="true" smooth="true">
                <image>
                    <Image url="@../images/conary_logo.png"/>
                </image>
                <VBox.margin>
                    <Insets bottom="6"/>
                </VBox.margin>
            </ImageView>

            <Label text="Papelería de Rosita" styleClass="login-title"/>
            <Label text="Bienvenida, ingrese sus datos para comenzar" styleClass="login-subtitle"/>

            <Region styleClass="login-divider">
                <VBox.margin>
                    <Insets top="10" bottom="4"/>
                </VBox.margin>
            </Region>
        </VBox>

        <!-- Campo: Nombre de Usuario -->
        <VBox alignment="CENTER_LEFT" spacing="6">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <SVGPath fill="#704214" content="M 7 7 C 8.66 7 10 5.66 10 4 C 10 2.34 8.66 1 7 1 C 5.34 1 4 2.34 4 4 C 4 5.66 5.34 7 7 7 Z M 7 8.5 C 4.67 8.5 0 9.67 0 12 L 0 13.5 L 14 13.5 L 14 12 C 14 9.67 9.33 8.5 7 8.5 Z"/>
                <Label text="Nombre de Usuario" styleClass="login-label"/>
            </HBox>

            <TextField fx:id="txtUsername"
                       minHeight="42" prefHeight="42" styleClass="login-input"/>

            <Label text="Escriba su identificador asignado por el sistema" styleClass="login-helper"/>
        </VBox>

        <!-- Campo: Contraseña con boton Ver Clave -->
        <VBox alignment="CENTER_LEFT" spacing="6">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <SVGPath fill="#704214" content="M 11 5 L 10 5 L 10 3.5 C 10 1.57 8.43 0 6.5 0 C 4.57 0 3 1.57 3 3.5 L 3 5 L 2 5 C 1.17 5 0.5 5.67 0.5 6.5 L 0.5 12.5 C 0.5 13.33 1.17 14 2 14 L 11 14 C 11.83 14 12.5 13.33 12.5 12.5 L 12.5 6.5 C 12.5 5.67 11.83 5 11 5 Z M 6.5 10.5 C 5.67 10.5 5 9.83 5 9 C 5 8.17 5.67 7.5 6.5 7.5 C 7.33 7.5 8 8.17 8 9 C 8 9.83 7.33 10.5 6.5 10.5 Z M 8.3 5 L 4.7 5 L 4.7 3.5 C 4.7 2.51 5.51 1.7 6.5 1.7 C 7.49 1.7 8.3 2.51 8.3 3.5 L 8.3 5 Z"/>
                <Label text="Contraseña" styleClass="login-label"/>
            </HBox>

            <StackPane fx:id="boxPasswordContainer" minHeight="42" prefHeight="42" styleClass="login-password-container">
                <PasswordField fx:id="txtPassword"
                               minHeight="42" prefHeight="42" styleClass="login-password-inner"/>
                <TextField fx:id="txtPasswordVisible"
                           minHeight="42" prefHeight="42" visible="false" managed="false"
                           styleClass="login-password-inner"/>
                <Button fx:id="btnTogglePassword" onAction="#togglePasswordVisibility"
                        focusTraversable="false" styleClass="login-eye-btn"
                        StackPane.alignment="CENTER_RIGHT">
                    <graphic>
                        <SVGPath fx:id="svgEye" fill="#704214"
                                 content="M 10 2 C 5.45 2 1.57 4.83 0 8.8 C 1.57 12.77 5.45 15.6 10 15.6 C 14.55 15.6 18.43 12.77 20 8.8 C 18.43 4.83 14.55 2 10 2 Z M 10 13.3 C 7.52 13.3 5.5 11.28 5.5 8.8 C 5.5 6.32 7.52 4.3 10 4.3 C 12.48 4.3 14.5 6.32 14.5 8.8 C 14.5 11.28 12.48 13.3 10 13.3 Z M 10 6.1 C 8.51 6.1 7.3 7.31 7.3 8.8 C 7.3 10.29 8.51 11.5 10 11.5 C 11.49 11.5 12.7 10.29 12.7 8.8 C 12.7 7.31 11.49 6.1 10 6.1 Z"/>
                    </graphic>
                </Button>
            </StackPane>

            <Label text="Haga clic en el ojo para verificar lo escrito" styleClass="login-helper"/>
        </VBox>

        <!-- Tarjeta de Error / Aviso (Oculta por defecto) -->
        <HBox fx:id="boxError" alignment="CENTER_LEFT" spacing="12"
              visible="false" managed="false" styleClass="login-error-box">
            <Label text="i" styleClass="login-error-icon"/>
            <Label fx:id="lblMensaje" text="" visible="false" managed="false"
                   wrapText="true" maxWidth="270" styleClass="login-error-text"/>
        </HBox>

        <!-- Boton Principal de Accion -->
        <Button fx:id="btnIngresar" text="INGRESAR AL SISTEMA   ➔" onAction="#handleLogin"
                maxWidth="Infinity" minHeight="46" prefHeight="46"
                styleClass="login-btn-primary">
            <VBox.margin>
                <Insets top="4"/>
            </VBox.margin>
        </Button>

        <!-- Pie de Tarjeta -->
        <Label text="Sistema comercial conary v1.0" styleClass="login-footer">
            <VBox.margin>
                <Insets top="6"/>
            </VBox.margin>
        </Label>

    </VBox>

</StackPane>

