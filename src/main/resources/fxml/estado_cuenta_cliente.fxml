<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.conary.rosita.controller.EstadoCuentaClienteController"
            fx:id="rootPane"
            styleClass="cuenta-cliente-root"
            maxWidth="Infinity" maxHeight="Infinity">

    <!-- ==================================================================
         ENCABEZADO SUPERIOR LIMPIO ESTANDAR DE CONARY
         ================================================================== -->
    <top>
        <VBox spacing="0">
            <padding>
                <Insets top="10" right="22" bottom="8" left="22"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="14" styleClass="cuenta-cliente-header-bar">
                <Button fx:id="btnVolverTop" text="←   Volver a Clientes"
                        onAction="#handleVolverAClientes"
                        styleClass="cuenta-cliente-btn-volver"/>

                <Region HBox.hgrow="ALWAYS"/>

                <VBox alignment="CENTER" spacing="2">
                    <HBox alignment="CENTER" spacing="10">
                        <SVGPath fill="transparent" stroke="#704214" strokeWidth="1.7"
                                 content="M 1 2.5 C 3 1.5 5.5 1.5 7.5 2.8 C 9.5 1.5 12 1.5 14 2.5 L 14 12.5 C 12 11.5 9.5 11.5 7.5 12.8 C 5.5 11.5 3 11.5 1 12.5 Z M 7.5 2.8 L 7.5 12.8"/>
                        <Label fx:id="lblTituloCuenta" text="Cuenta de María Gómez"
                               styleClass="cuenta-cliente-header-title"/>
                    </HBox>
                    <Label fx:id="lblSubtituloTelefono" text="310 555 0142"
                           styleClass="cuenta-cliente-header-subtitle"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Capsula de Usuario en Sesion Real -->
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="clientes-user-pill">
                    <StackPane>
                        <Circle radius="14" fill="#5C300C"/>
                        <SVGPath fill="#FAF6F0"
                                 content="M 0 -5 C -2.2 -5 -4 -3.2 -4 -1 C -4 1.2 -2.2 3 0 3 C 2.2 3 4 1.2 4 -1 C 4 -3.2 2.2 -5 0 -5 Z M 0 5 C -3.5 5 -7 6.8 -7 9.5 L 7 9.5 C 7 6.8 3.5 5 0 5 Z"/>
                    </StackPane>
                    <VBox alignment="CENTER_LEFT" spacing="0">
                        <Label fx:id="lblUsuarioNombre" text="Doña Rosita" styleClass="reg-cliente-user-name"/>
                        <Label fx:id="lblUsuarioRol" text="Administradora" styleClass="reg-cliente-user-role"/>
                    </VBox>
                </HBox>
            </HBox>
        </VBox>
    </top>

    <!-- ==================================================================
         CONTENIDO CENTRAL: 3 TARJETAS DE RESUMEN, TABLA DE MOVIMIENTOS Y ACCIONES
         ================================================================== -->
    <center>
        <VBox spacing="12" VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="2" right="22" bottom="8" left="22"/>
            </padding>

            <!-- 1. 3 Tarjetas Superiores de Resumen Financiero -->
            <GridPane hgap="16">
                <columnConstraints>
                    <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="33.34" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                </columnConstraints>

                <!-- Tarjeta 1: CUPO DE FIADO -->
                <VBox spacing="4" styleClass="cuenta-cliente-kpi-white"
                      GridPane.columnIndex="0">
                    <Label text="CUPO DE FIADO" styleClass="cuenta-cliente-kpi-kicker"/>
                    <Label fx:id="lblCupoFiado" text="\$ 100.000" styleClass="cuenta-cliente-kpi-value"/>
                </VBox>

                <!-- Tarjeta 2: DEBE AHORA (Resaltada en melocoton suave) -->
                <StackPane styleClass="cuenta-cliente-kpi-highlight"
                           GridPane.columnIndex="1">
                    <Circle radius="22" fill="#F3CFBC" StackPane.alignment="TOP_RIGHT"/>
                    <VBox spacing="3" alignment="CENTER_LEFT">
                        <Label text="DEBE AHORA" styleClass="cuenta-cliente-kpi-kicker-highlight"/>
                        <Label fx:id="lblDebeAhora" text="\$ 20.000" styleClass="cuenta-cliente-kpi-value-big"/>
                    </VBox>
                </StackPane>

                <!-- Tarjeta 3: PUEDE DEBER -->
                <VBox spacing="4" styleClass="cuenta-cliente-kpi-white"
                      GridPane.columnIndex="2">
                    <Label text="PUEDE DEBER" styleClass="cuenta-cliente-kpi-kicker"/>
                    <Label fx:id="lblPuedeDeber" text="\$ 80.000 más" styleClass="cuenta-cliente-kpi-value"/>
                </VBox>
            </GridPane>

            <!-- 2. Tabla de Movimientos ("Del mas nuevo al mas antiguo") -->
            <VBox spacing="0" VBox.vgrow="ALWAYS" styleClass="cuenta-cliente-table-card">
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="cuenta-cliente-table-top-bar">
                    <Label text="Movimientos" styleClass="cuenta-cliente-movs-title"/>
                    <Label text="Del más nuevo al más antiguo" styleClass="cuenta-cliente-movs-subtitle"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblConteoMovimientos" text="Mostrando 0 registros"
                           styleClass="cuenta-cliente-movs-count"/>
                </HBox>

                <TableView fx:id="tblMovimientosCliente" VBox.vgrow="ALWAYS"
                           styleClass="cuenta-cliente-table">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colFecha" text="FECHA" prefWidth="210" minWidth="150"/>
                        <TableColumn fx:id="colQueFue" text="QUÉ FUE" prefWidth="230" minWidth="170"/>
                        <TableColumn fx:id="colValor" text="VALOR" prefWidth="240" minWidth="170"/>
                        <TableColumn fx:id="colDebiaDespues" text="DEBÍA DESPUÉS" prefWidth="220" minWidth="160"/>
                    </columns>
                    <placeholder>
                        <VBox alignment="CENTER" spacing="6" style="-fx-padding: 32;">
                            <Label text="Este cliente aún no registra ventas a fiado ni abonos."
                                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #6B4C35;"/>
                            <Label text="Cuando realice compras a fiado o registre abonos aparecerán aquí."
                                   style="-fx-font-size: 13px; -fx-text-fill: #8D7B6A;"/>
                        </VBox>
                    </placeholder>
                </TableView>
            </VBox>

            <!-- 3. Botones Inferiores Alineados a la Derecha -->
            <HBox alignment="CENTER_RIGHT" spacing="12">
                <Button text="←   Volver a Clientes"
                        onAction="#handleVolverAClientes"
                        styleClass="cuenta-cliente-btn-secondary"/>

                <Button fx:id="btnAutorizarFiado" text="☑   Autorizar fiado"
                        onAction="#handleAutorizarFiado"
                        styleClass="cuenta-cliente-btn-secondary"/>

                <Button fx:id="btnRegistrarAbono" text="💵   Registrar abono"
                        onAction="#handleRegistrarAbono"
                        styleClass="cuenta-cliente-btn-primary"/>
            </HBox>

        </VBox>
    </center>

    <!-- ==================================================================
         PIE DE PAGINA
         ================================================================== -->
    <bottom>
        <HBox alignment="CENTER_LEFT">
            <padding>
                <Insets top="2" right="24" bottom="8" left="24"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Circle radius="4" fill="#B56A27"/>
                <Label text="Datos guardados en este equipo" styleClass="cuenta-cliente-footer-text"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Papelería de Rosita · CONARY v1.0" styleClass="cuenta-cliente-footer-text"/>
        </HBox>
    </bottom>

</BorderPane>
