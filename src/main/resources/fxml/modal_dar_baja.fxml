<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<StackPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.conary.rosita.controller.DarBajaProductoController"
           styleClass="modal-prod-backdrop">
    <padding>
        <Insets top="14" right="14" bottom="14" left="14"/>
    </padding>

    <VBox spacing="16" prefWidth="500" maxWidth="500" styleClass="modal-prod-card">

        <!-- Cabecera del Modal -->
        <HBox alignment="CENTER_LEFT" spacing="14">
            <StackPane styleClass="modal-prod-icon-box">
                <SVGPath fill="transparent" stroke="#5C3419" strokeWidth="1.6"
                         content="M 8 1 L 15 4.8 L 15 12.2 L 8 16 L 1 12.2 L 1 4.8 L 8 1 Z M 1 4.8 L 8 8.6 L 15 4.8 M 8 8.6 L 8 16"/>
            </StackPane>
            <VBox spacing="2">
                <Label text="¿Dar de baja este producto?" styleClass="modal-prod-title"/>
                <Label text="Archivar producto del catálogo activo" styleClass="modal-prod-subtitle"/>
            </VBox>
        </HBox>

        <!-- Franja del Producto -->
        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="modal-prod-product-strip">
            <Circle radius="3.8" fill="#6B3A19"/>
            <Label fx:id="lblProductoResumen"
                   text="Marcador permanente negro · PRD-005"
                   wrapText="true" styleClass="modal-prod-product-name"/>
        </HBox>

        <!-- Lista Informativa de Consecuencias (3 filas) -->
        <VBox spacing="10">
            <!-- Fila 1 -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane styleClass="modal-prod-consequence-circle">
                    <SVGPath fill="transparent" stroke="#6B4C35" strokeWidth="1.4"
                             content="M 5.5 1 C 3.01 1 1 3.01 1 5.5 C 1 7.99 3.01 10 5.5 10 C 7.99 10 10 7.99 10 5.5 C 10 3.01 7.99 1 5.5 1 Z M 9 9 L 12.5 12.5 M 2.5 2.5 L 8.5 8.5"/>
                </StackPane>
                <Label text="Ya no aparecerá al vender ni al comprar."
                       wrapText="true" styleClass="modal-prod-consequence-text"/>
            </HBox>

            <!-- Fila 2 -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane styleClass="modal-prod-consequence-circle">
                    <SVGPath fill="transparent" stroke="#6B4C35" strokeWidth="1.4"
                             content="M 1 2 L 6 2 C 6.8 2 7.5 2.7 7.5 3.5 L 7.5 11.5 C 7.5 10.8 6.8 10.2 6 10.2 L 1 10.2 Z M 14 2 L 9 2 C 8.2 2 7.5 2.7 7.5 3.5 L 7.5 11.5 C 7.5 10.8 8.2 10.2 9 10.2 L 14 10.2 Z"/>
                </StackPane>
                <Label text="Su historial de ventas y compras se conserva."
                       wrapText="true" styleClass="modal-prod-consequence-text"/>
            </HBox>

            <!-- Fila 3 -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane styleClass="modal-prod-consequence-circle">
                    <SVGPath fill="transparent" stroke="#6B4C35" strokeWidth="1.4"
                             content="M 2 5.5 C 2.5 3.0 4.6 1.2 7.2 1.2 C 9.6 1.2 11.6 2.7 12.3 4.9 M 12.5 2.2 L 12.5 5.1 L 9.6 5.1 M 12.4 8.5 C 11.9 11.0 9.8 12.8 7.2 12.8 C 4.8 12.8 2.8 11.3 2.1 9.1 M 1.9 11.8 L 1.9 8.9 L 4.8 8.9"/>
                </StackPane>
                <Label text="Podrá volver a activarlo cuando lo necesite."
                       wrapText="true" styleClass="modal-prod-consequence-text"/>
            </HBox>
        </VBox>

        <!-- Aviso Condicional de Existencias (solo visible si stock > 0) -->
        <HBox fx:id="boxAvisoStock" alignment="CENTER_LEFT" spacing="10"
              styleClass="modal-prod-diff-amber">
            <SVGPath fill="transparent" stroke="#9E5827" strokeWidth="1.5"
                     content="M 7 1 L 13 4.2 L 13 10.8 L 7 14 L 1 10.8 L 1 4.2 L 7 1 Z M 1 4.2 L 7 7.4 L 13 4.2 M 7 7.4 L 7 14"/>
            <Label fx:id="lblAvisoStock"
                   text="Todavía quedan 2 unidades en el inventario."
                   wrapText="true" styleClass="modal-prod-diff-text" HBox.hgrow="ALWAYS"/>
        </HBox>

        <!-- Botones Inferiores (50% / 50%) -->
        <HBox spacing="12" alignment="CENTER">
            <Button fx:id="btnNoVolver" text="←   No, volver" onAction="#handleCancelar"
                    maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="modal-prod-btn-save"/>
            <Button fx:id="btnConfirmarBaja" text="  Sí, dar de baja" onAction="#handleConfirmarBaja"
                    maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="modal-prod-btn-danger">
                <graphic>
                    <SVGPath fill="transparent" stroke="#C92A2A" strokeWidth="1.5"
                             content="M 7 1 L 13 4.2 L 13 10.8 L 7 14 L 1 10.8 L 1 4.2 L 7 1 Z M 1 4.2 L 7 7.4 L 13 4.2 M 7 7.4 L 7 14"/>
                </graphic>
            </Button>
        </HBox>

    </VBox>
</StackPane>
