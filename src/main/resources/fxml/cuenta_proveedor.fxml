<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.conary.rosita.controller.CuentaProveedorController"
            fx:id="rootPane"
            styleClass="cuenta-cliente-root"
            maxWidth="Infinity" maxHeight="Infinity">

    <!-- ==================================================================
         CABECERA ESTANDAR LIMPIA DE CONARY: CUENTA DEL PROVEEDOR
         ================================================================== -->
    <top>
        <VBox spacing="0">
            <padding>
                <Insets top="10" right="22" bottom="8" left="22"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="14" styleClass="cuenta-cliente-header-bar">
                <Button fx:id="btnVolverTop" text="←   Volver a Proveedores"
                        onAction="#handleVolverAProveedores"
                        styleClass="cuenta-cliente-btn-volver"/>

                <Region HBox.hgrow="ALWAYS"/>

                <VBox alignment="CENTER" spacing="2">
                    <HBox alignment="CENTER" spacing="10">
                        <SVGPath fill="transparent" stroke="#704214" strokeWidth="1.7"
                                 content="M 1 2.5 C 3 1.5 5.5 1.5 7.5 2.8 C 9.5 1.5 12 1.5 14 2.5 L 14 12.5 C 12 11.5 9.5 11.5 7.5 12.8 C 5.5 11.5 3 11.5 1 12.5 Z M 7.5 2.8 L 7.5 12.8"/>
                        <Label fx:id="lblTituloCuenta" text="Cuenta de Proveedor"
                               styleClass="cuenta-cliente-header-title"/>
                    </HBox>
                    <Label fx:id="lblSubtituloProveedor" text="Teléfono: — · Le compra: —"
                           styleClass="cuenta-cliente-header-subtitle"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Capsula de Usuario en Sesion Real -->
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="clientes-user-pill">
                    <StackPane>
                        <Circle radius="14" fill="#5C300C"/>
                        <SVGPath fill="#FAF6F0"
                                 content="M 0 -5 C -2.2 -5 -4 -3.2 -4 -1 C -4 1.2 -2.2 3 0 3 C 2.2 3 4 1.2 4 -1 C 4 -3.2 2.2 -5 0 -5 Z M 0 5 C -3.5 5 -7 6.8 -7 9.5 L 7 9.5 C 7 6.8 3.5 5 0 5 Z"/>
                    </StackPane>
                    <VBox alignment="CENTER_LEFT" spacing="0">
                        <Label fx:id="lblUsuarioNombre" text="Doña Rosita" styleClass="reg-cliente-user-name"/>
                        <Label fx:id="lblUsuarioRol" text="Administradora" styleClass="reg-cliente-user-role"/>
                    </VBox>
                </HBox>
            </HBox>
        </VBox>
    </top>

    <!-- ==================================================================
         CONTENIDO CENTRAL: 3 TARJETAS KPI, TABLA DE MOVIMIENTOS Y ACCIONES
         ================================================================== -->
    <center>
        <VBox spacing="12" VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="2" right="22" bottom="12" left="22"/>
            </padding>

            <!-- 1. 3 Tarjetas Superiores de Resumen -->
            <GridPane hgap="16">
                <columnConstraints>
                    <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="33.34" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                </columnConstraints>

                <!-- Tarjeta 1: LE DEBO (Cafe oscuro #704214) -->
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="cuenta-proveedor-kpi-dark"
                      GridPane.columnIndex="0">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Le debo" styleClass="cuenta-proveedor-kpi-dark-kicker"/>
                        <Label fx:id="lblLeDebo" text="\$ 0" styleClass="cuenta-proveedor-kpi-dark-value"/>
                    </VBox>
                    <StackPane styleClass="cuenta-proveedor-kpi-dark-icon">
                        <SVGPath fill="transparent" stroke="#FAF6F0" strokeWidth="1.6"
                                 content="M 1 3 L 15 3 L 15 12 L 1 12 Z M 8 5.5 C 6.9 5.5 6 6.4 6 7.5 C 6 8.6 6.9 9.5 8 9.5 C 9.1 9.5 10 8.6 10 7.5 C 10 6.4 9.1 5.5 8 5.5 Z"/>
                    </StackPane>
                </HBox>

                <!-- Tarjeta 2: PROXIMO PAGO -->
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="cuenta-proveedor-kpi-white"
                      GridPane.columnIndex="1">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Próximo pago" styleClass="cuenta-cliente-kpi-kicker"/>
                        <Label fx:id="lblProximoPago" text="—" styleClass="cuenta-proveedor-kpi-value"/>
                    </VBox>
                    <StackPane styleClass="cuenta-proveedor-kpi-icon">
                        <SVGPath fill="transparent" stroke="#704214" strokeWidth="1.6"
                                 content="M 2 3 L 14 3 L 14 14 L 2 14 Z M 2 7 L 14 7 M 5 1 L 5 4 M 11 1 L 11 4"/>
                    </StackPane>
                </HBox>

                <!-- Tarjeta 3: LO COMPRADO ESTE ANO -->
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="cuenta-proveedor-kpi-white"
                      GridPane.columnIndex="2">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Lo comprado este año" styleClass="cuenta-cliente-kpi-kicker"/>
                        <Label fx:id="lblCompradoAnio" text="0 facturas" styleClass="cuenta-proveedor-kpi-value"/>
                    </VBox>
                    <StackPane styleClass="cuenta-proveedor-kpi-icon">
                        <SVGPath fill="transparent" stroke="#704214" strokeWidth="1.6"
                                 content="M 2 1 L 12 1 L 12 14 L 9.5 12.5 L 7 14 L 4.5 12.5 L 2 14 Z M 4.5 5 L 9.5 5 M 4.5 8 L 9.5 8"/>
                    </StackPane>
                </HBox>
            </GridPane>

            <!-- 2. Tabla de Movimientos -->
            <VBox spacing="0" VBox.vgrow="ALWAYS" styleClass="cuenta-cliente-table-card">
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="cuenta-cliente-table-top-bar">
                    <Label text="Movimientos" styleClass="cuenta-cliente-movs-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblConteoMovimientos" text="Últimos 0 registros"
                           styleClass="cuenta-cliente-movs-count"/>
                </HBox>

                <TableView fx:id="tblMovimientosProveedor" VBox.vgrow="ALWAYS"
                           styleClass="cuenta-cliente-table">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colFecha" text="Fecha" prefWidth="185" minWidth="140"/>
                        <TableColumn fx:id="colQueFue" text="Qué fue" prefWidth="170" minWidth="140"/>
                        <TableColumn fx:id="colFactura" text="Factura" prefWidth="140" minWidth="110"/>
                        <TableColumn fx:id="colValor" text="Valor" prefWidth="195" minWidth="150"/>
                        <TableColumn fx:id="colDebiaDespues" text="Le debía después" prefWidth="210" minWidth="160"/>
                    </columns>
                    <placeholder>
                        <VBox alignment="CENTER" spacing="6" style="-fx-padding: 32;">
                            <Label text="Este proveedor aún no registra compras ni pagos."
                                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #6B4C35;"/>
                            <Label text="Cuando registre compras o pagos aparecerán aquí."
                                   style="-fx-font-size: 13px; -fx-text-fill: #8D7B6A;"/>
                        </VBox>
                    </placeholder>
                </TableView>
            </VBox>

            <!-- 3. Barra de Acciones Inferiores -->
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="cuenta-proveedor-bottom-bar">
                <Button fx:id="btnVolverBottom" text="←   Volver a Proveedores"
                        onAction="#handleVolverAProveedores"
                        styleClass="reg-proveedor-btn-cancel"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="btnRegistrarCompra" text="🚚   Registrar compra"
                        onAction="#handleRegistrarCompra"
                        styleClass="reg-proveedor-btn-cancel"/>

                <Button fx:id="btnRegistrarPago" text="💵   Registrar pago"
                        onAction="#handleRegistrarPago"
                        styleClass="cuenta-cliente-btn-primary"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>