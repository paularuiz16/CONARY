<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<StackPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.conary.rosita.controller.CambiarClaveController"
           fx:id="overlayRoot"
           alignment="CENTER"
           style="-fx-background-color: rgba(35, 16, 6, 0.45); -fx-padding: 24;">

    <VBox spacing="16" maxWidth="455" prefWidth="455" maxHeight="-Infinity"
          styleClass="modal-clave-card">

        <!-- Cabecera: Icono llave + Titulo -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <StackPane styleClass="modal-clave-icon-box">
                <SVGPath fill="#FAF6F0"
                         content="M 6 0 C 2.7 0 0 2.7 0 6 C 0 9.3 2.7 12 6 12 C 8.6 12 10.8 10.3 11.6 8 L 16 8 L 16 11 L 19 11 L 19 8 L 21 8 L 21 5 L 11.6 5 C 10.8 2.7 8.6 0 6 0 Z M 6 8.5 C 4.6 8.5 3.5 7.4 3.5 6 C 3.5 4.6 4.6 3.5 6 3.5 C 7.4 3.5 8.5 4.6 8.5 6 C 8.5 7.4 7.4 8.5 6 8.5 Z"/>
            </StackPane>
            <Label text="Cambiar clave" styleClass="modal-clave-titulo"/>
        </HBox>

        <!-- Tarjeta Resumen del Usuario -->
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="modal-clave-usuario-box">
            <StackPane styleClass="modal-clave-avatar">
                <SVGPath fill="#704214"
                         content="M 0 -4.8 C -2.1 -4.8 -3.8 -3.1 -3.8 -1 C -3.8 1.1 -2.1 2.8 0 2.8 C 2.1 2.8 3.8 1.1 3.8 -1 C 3.8 -3.1 2.1 -4.8 0 -4.8 Z M 0 4.6 C -3.6 4.6 -6.8 6.3 -6.8 8.8 L 6.8 8.8 C 6.8 6.3 3.6 4.6 0 4.6 Z"/>
            </StackPane>

            <VBox spacing="1" HBox.hgrow="ALWAYS">
                <Label fx:id="lblNombreUsuario" text="Gladys" styleClass="modal-clave-usuario-nombre"/>
                <Label fx:id="lblUsername" text="@gladys" styleClass="modal-clave-usuario-username"/>
            </VBox>

            <Label fx:id="lblRolUsuario" text="VENDEDORA" styleClass="modal-clave-badge-rol"/>
        </HBox>

        <!-- Banner de Validacion -->
        <HBox fx:id="boxAlertaClave" alignment="CENTER_LEFT" spacing="10"
              visible="false" managed="false"
              styleClass="reg-usuario-alerta">
            <SVGPath fill="#704214"
                     content="M 10 2 L 1 18 L 19 18 Z M 9.2 8 L 10.8 8 L 10.6 13 L 9.4 13 Z M 10 14.3 C 10.6 14.3 11 14.7 11 15.3 C 11 15.9 10.6 16.3 10 16.3 C 9.4 16.3 9 15.9 9 15.3 C 9 14.7 9.4 14.3 10 14.3 Z"/>
            <Label fx:id="lblAlertaClave"
                   text="La clave debe tener mínimo 6 caracteres."
                   wrapText="true" HBox.hgrow="ALWAYS"
                   styleClass="reg-usuario-alerta-texto"/>
        </HBox>

        <!-- Clave nueva -->
        <VBox spacing="6">
            <HBox alignment="BASELINE_LEFT">
                <Label text="Clave nueva" styleClass="reg-usuario-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Obligatorio" styleClass="reg-usuario-obligatorio"/>
            </HBox>
            <HBox fx:id="boxClaveNueva" alignment="CENTER_LEFT" styleClass="reg-usuario-password-box">
                <StackPane HBox.hgrow="ALWAYS">
                    <PasswordField fx:id="txtClaveNueva" promptText="Mínimo 6 caracteres"
                                   styleClass="reg-usuario-password-inner"/>
                    <TextField fx:id="txtClaveNuevaVisible" promptText="Mínimo 6 caracteres"
                               visible="false" managed="false"
                               styleClass="reg-usuario-password-inner"/>
                </StackPane>
                <Button fx:id="btnVerClaveNueva" focusTraversable="false"
                        onAction="#handleToggleVerClaveNueva"
                        styleClass="reg-usuario-btn-ojo">
                    <graphic>
                        <SVGPath fx:id="svgOjoClaveNueva" fill="#46220F"
                                 content="M 10 2 C 5.45 2 1.57 4.83 0 8.8 C 1.57 12.77 5.45 15.6 10 15.6 C 14.55 15.6 18.43 12.77 20 8.8 C 18.43 4.83 14.55 2 10 2 Z M 10 13.3 C 7.52 13.3 5.5 11.28 5.5 8.8 C 5.5 6.32 7.52 4.3 10 4.3 C 12.48 4.3 14.5 6.32 14.5 8.8 C 14.5 11.28 12.48 13.3 10 13.3 Z M 10 6.1 C 8.51 6.1 7.3 7.31 7.3 8.8 C 7.3 10.29 8.51 11.5 10 11.5 C 11.49 11.5 12.7 10.29 12.7 8.8 C 12.7 7.31 11.49 6.1 10 6.1 Z"/>
                    </graphic>
                </Button>
            </HBox>
        </VBox>

        <!-- Repita la clave nueva -->
        <VBox spacing="6">
            <HBox alignment="BASELINE_LEFT">
                <Label text="Repita la clave nueva" styleClass="reg-usuario-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Obligatorio" styleClass="reg-usuario-obligatorio"/>
            </HBox>
            <HBox fx:id="boxRepetirClaveNueva" alignment="CENTER_LEFT" styleClass="reg-usuario-password-box">
                <StackPane HBox.hgrow="ALWAYS">
                    <PasswordField fx:id="txtRepetirClaveNueva" promptText="Repita la clave nueva"
                                   styleClass="reg-usuario-password-inner"/>
                    <TextField fx:id="txtRepetirClaveNuevaVisible" promptText="Repita la clave nueva"
                               visible="false" managed="false"
                               styleClass="reg-usuario-password-inner"/>
                </StackPane>
                <Button fx:id="btnVerRepetirClaveNueva" focusTraversable="false"
                        onAction="#handleToggleVerRepetirClaveNueva"
                        styleClass="reg-usuario-btn-ojo">
                    <graphic>
                        <SVGPath fx:id="svgOjoRepetirClaveNueva" fill="#46220F"
                                 content="M 10 2 C 5.45 2 1.57 4.83 0 8.8 C 1.57 12.77 5.45 15.6 10 15.6 C 14.55 15.6 18.43 12.77 20 8.8 C 18.43 4.83 14.55 2 10 2 Z M 10 13.3 C 7.52 13.3 5.5 11.28 5.5 8.8 C 5.5 6.32 7.52 4.3 10 4.3 C 12.48 4.3 14.5 6.32 14.5 8.8 C 14.5 11.28 12.48 13.3 10 13.3 Z M 10 6.1 C 8.51 6.1 7.3 7.31 7.3 8.8 C 7.3 10.29 8.51 11.5 10 11.5 C 11.49 11.5 12.7 10.29 12.7 8.8 C 12.7 7.31 11.49 6.1 10 6.1 Z"/>
                    </graphic>
                </Button>
            </HBox>
        </VBox>

        <!-- Nota informativa de candado -->
        <HBox alignment="CENTER_LEFT" spacing="8">
            <SVGPath fill="#5E4532"
                     content="M 4 6 L 4 4.5 C 4 2.6 5.6 1 7.5 1 C 9.4 1 11 2.6 11 4.5 L 11 6 L 12 6 C 12.6 6 13 6.4 13 7 L 13 13 C 13 13.6 12.6 14 12 14 L 3 14 C 2.4 14 2 13.6 2 13 L 2 7 C 2 6.4 2.4 6 3 6 Z M 5.5 6 L 9.5 6 L 9.5 4.5 C 9.5 3.4 8.6 2.5 7.5 2.5 C 6.4 2.5 5.5 3.4 5.5 4.5 Z"/>
            <Label fx:id="lblNotaSeguridad"
                   text="Gladys entrará con la clave nueva. La anterior deja de servir."
                   wrapText="true" HBox.hgrow="ALWAYS"
                   styleClass="modal-clave-nota"/>
        </HBox>

        <!-- Botones de accion -->
        <HBox spacing="12">
            <padding>
                <Insets top="4"/>
            </padding>
            <Button fx:id="btnCancelar" text="Cancelar"
                    maxWidth="Infinity" HBox.hgrow="ALWAYS"
                    onAction="#handleCancelar"
                    styleClass="reg-usuario-btn-cancelar"/>
            <Button fx:id="btnGuardarClave" text="✓   Guardar clave"
                    maxWidth="Infinity" HBox.hgrow="ALWAYS"
                    defaultButton="true"
                    onAction="#handleGuardarClave"
                    styleClass="reg-usuario-btn-guardar"/>
        </HBox>
    </VBox>

</StackPane>
