<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.conary.rosita.controller.AbrirCajaController"
            fx:id="rootPane"
            styleClass="abrir-caja-root"
            maxWidth="Infinity" maxHeight="Infinity">

    <!-- ==================================================================
         ENCABEZADO SUPERIOR CONTEXTUAL
         ================================================================== -->
    <top>
        <VBox spacing="0">
            <padding>
                <Insets top="14" right="24" bottom="8" left="24"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="14" styleClass="abrir-caja-header-bar">
                <Button fx:id="btnVolverHeader" text="←  Volver al Menú" onAction="#handleVolverMenu"
                        styleClass="abrir-caja-btn-volver-top"/>

                <StackPane styleClass="abrir-caja-header-icon-box">
                    <SVGPath fill="#704214"
                             content="M 2 1 C 1.17 1 0.5 1.67 0.5 2.5 L 0.5 13.5 C 0.5 14.33 1.17 15 2 15 L 12 15 C 12.83 15 13.5 14.33 13.5 13.5 L 13.5 2.5 C 13.5 1.67 12.83 1 12 1 L 2 1 Z M 2.5 3 L 11.5 3 L 11.5 6 L 2.5 6 L 2.5 3 Z M 3.5 8 L 5.5 8 L 5.5 9.5 L 3.5 9.5 L 3.5 8 Z M 6 8 L 8 8 L 8 9.5 L 6 9.5 L 6 8 Z M 8.5 8 L 10.5 8 L 10.5 9.5 L 8.5 9.5 L 8.5 8 Z M 3.5 11 L 5.5 11 L 5.5 12.5 L 3.5 12.5 L 3.5 11 Z M 6 11 L 10.5 11 L 10.5 12.5 L 6 12.5 L 6 11 Z"/>
                </StackPane>

                <VBox alignment="CENTER_LEFT" spacing="1">
                    <Label fx:id="lblTituloHeader" text="Abrir caja" styleClass="abrir-caja-header-title"/>
                    <Label fx:id="lblFechaHeader" text="Domingo, 15 de noviembre de 2026" styleClass="abrir-caja-header-date"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Capsula de Usuario en Sesion Real -->
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="abrir-caja-user-pill">
                    <StackPane>
                        <Circle radius="14" fill="#46220F"/>
                        <SVGPath fill="#FAF6F0"
                                 content="M 0 -5 C -2.2 -5 -4 -3.2 -4 -1 C -4 1.2 -2.2 3 0 3 C 2.2 3 4 1.2 4 -1 C 4 -3.2 2.2 -5 0 -5 Z M 0 5 C -3.5 5 -7 6.8 -7 9.5 L 7 9.5 C 7 6.8 3.5 5 0 5 Z"/>
                    </StackPane>
                    <VBox alignment="CENTER_LEFT" spacing="0">
                        <Label fx:id="lblUsuarioNombre" text="Gladys" styleClass="abrir-caja-user-name"/>
                        <Label fx:id="lblUsuarioRol" text="Vendedora" styleClass="abrir-caja-user-role"/>
                    </VBox>
                </HBox>

                <StackPane styleClass="abrir-caja-user-badge-circle">
                    <Circle radius="15" fill="#46220F"/>
                    <SVGPath fill="#FAF6F0"
                             content="M 0 -5 C -2.2 -5 -4 -3.2 -4 -1 C -4 1.2 -2.2 3 0 3 C 2.2 3 4 1.2 4 -1 C 4 -3.2 2.2 -5 0 -5 Z M 0 5 C -3.5 5 -7 6.8 -7 9.5 L 7 9.5 C 7 6.8 3.5 5 0 5 Z"/>
                </StackPane>
            </HBox>
        </VBox>
    </top>

    <!-- ==================================================================
         CONTENEDOR CENTRAL MULTIVISTA (4 ESTADOS DINAMICOS)
         ================================================================== -->
    <center>
        <StackPane maxWidth="Infinity" maxHeight="Infinity">
            <padding>
                <Insets top="8" right="24" bottom="8" left="24"/>
            </padding>

            <!-- ==========================================================
                 ESTADO 1: BLOQUEO POR CAJA ANTERIOR PENDIENTE
                 ========================================================== -->
            <VBox fx:id="panelCajaAnteriorPendiente" alignment="TOP_CENTER" spacing="14"
                  maxWidth="520" maxHeight="-Infinity" visible="false" managed="false"
                  styleClass="abrir-caja-card">

                <!-- Icono circular melocoton con candado y reloj -->
                <StackPane minWidth="58" minHeight="58" maxWidth="58" maxHeight="58"
                           styleClass="abrir-caja-circle-peach">
                    <SVGPath fill="#46220F"
                             content="M 11 5 L 10 5 L 10 3.5 C 10 1.57 8.43 0 6.5 0 C 4.57 0 3 1.57 3 3.5 L 3 5 L 2 5 C 1.17 5 0.5 5.67 0.5 6.5 L 0.5 12.5 C 0.5 13.33 1.17 14 2 14 L 11 14 C 11.83 14 12.5 13.33 12.5 12.5 L 12.5 6.5 C 12.5 5.67 11.83 5 11 5 Z M 8.3 5 L 4.7 5 L 4.7 3.5 C 4.7 2.51 5.51 1.7 6.5 1.7 C 7.49 1.7 8.3 2.51 8.3 3.5 L 8.3 5 Z"/>
                </StackPane>

                <Label text="🛡  BLOQUEO DE SEGURIDAD · CAJA ANTERIOR PENDIENTE"
                       styleClass="abrir-caja-kicker-pill"/>

                <Label text="No se puede abrir la caja todavía"
                       styleClass="abrir-caja-card-title" wrapText="true" textAlignment="CENTER"/>

                <Label text="Hay un turno anterior que aún no ha sido cerrado formalmente en el sistema."
                       styleClass="abrir-caja-card-subtitle" wrapText="true" textAlignment="CENTER" maxWidth="420"/>

                <!-- Caja de alerta ambar suave -->
                <VBox spacing="10" styleClass="abrir-caja-alert-box">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <StackPane minWidth="28" minHeight="28" maxWidth="28" maxHeight="28"
                                   styleClass="abrir-caja-icon-dark-circle">
                            <Label text="⚠" style="-fx-text-fill: #FAF6F0; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                        </StackPane>
                        <Label text="Falta cerrar la caja de ayer. Pida a Doña Rosita que haga el cierre antes de abrir una nueva."
                               wrapText="true" maxWidth="380"
                               styleClass="abrir-caja-alert-headline"/>
                    </HBox>

                    <VBox spacing="7" styleClass="abrir-caja-alert-inner">
                        <HBox alignment="TOP_LEFT" spacing="8">
                            <Label text="🕒" style="-fx-font-size: 12px; -fx-text-fill: #704214;"/>
                            <Label fx:id="lblTurnoPendienteDetalle"
                                   text="Turno pendiente: Viernes, 23 de octubre · Registrado por última vez a las 7:45 p. m."
                                   wrapText="true" maxWidth="380"
                                   styleClass="abrir-caja-alert-detail"/>
                        </HBox>
                        <HBox alignment="TOP_LEFT" spacing="8">
                            <Label fx:id="lblIconoPermisoRol" text="✓" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #704214;"/>
                            <Label fx:id="lblMensajePermisoRol"
                                   text="Como usted ha iniciado sesión como Doña Rosita (Administradora), puede realizar el cierre de inmediato aquí debajo."
                                   wrapText="true" maxWidth="380"
                                   styleClass="abrir-caja-alert-detail"/>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- Selector de Modo de Visualizacion (Doña Rosita vs Gladys) -->
                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="abrir-caja-role-switch-bar">
                    <Label text="👜  Modo de visualización:" styleClass="abrir-caja-role-switch-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnModoAdmin" text="Doña Rosita (Admin)"
                            onAction="#handleVerComoAdmin"
                            styleClass="abrir-caja-role-btn-active"/>
                    <Button fx:id="btnModoVendedora" text="Gladys (Vendedora)"
                            onAction="#handleVerComoVendedora"
                            styleClass="abrir-caja-role-btn-inactive"/>
                </HBox>

                <!-- Boton exclusivo para Administradora -->
                <Button fx:id="btnCerrarCajaAyer" text="📠   Cerrar la caja de ayer"
                        onAction="#handleCerrarCajaAyer"
                        maxWidth="Infinity" styleClass="abrir-caja-btn-primary"/>

                <Button text="←   Volver al Menú Principal" onAction="#handleVolverMenu"
                        maxWidth="Infinity" styleClass="abrir-caja-btn-ghost"/>

                <HBox alignment="CENTER" spacing="8" style="-fx-padding: 2 8 0 8;">
                    <Label text="ⓘ" style="-fx-text-fill: #7A5C43; -fx-font-size: 13px;"/>
                    <Label text="Si una vendedora (Gladys) ingresa a esta pantalla, solo verá disponible el botón &quot;Volver al Menú&quot; hasta que Doña Rosita complete el arqueo."
                           wrapText="true" textAlignment="CENTER" maxWidth="420"
                           styleClass="abrir-caja-footnote"/>
                </HBox>
            </VBox>

            <!-- ==========================================================
                 ESTADO 2: LA CAJA DE HOY YA FUE ABIERTA
                 ========================================================== -->
            <VBox fx:id="panelCajaYaAbierta" alignment="TOP_CENTER" spacing="14"
                  maxWidth="500" maxHeight="-Infinity" visible="false" managed="false"
                  styleClass="abrir-caja-card">

                <!-- Icono circular doble con check y candado -->
                <StackPane minWidth="62" minHeight="62" maxWidth="62" maxHeight="62">
                    <Circle radius="29" fill="#F6CFB0"/>
                    <Circle radius="16" fill="#5C330F"/>
                    <Label text="✓" style="-fx-text-fill: #FAF6F0; -fx-font-size: 15px; -fx-font-weight: bold;"/>
                    <StackPane StackPane.alignment="BOTTOM_RIGHT" minWidth="20" minHeight="20" maxWidth="20" maxHeight="20"
                               style="-fx-background-color: #46220F; -fx-background-radius: 10px;">
                        <Label text="🔒" style="-fx-text-fill: #FAF6F0; -fx-font-size: 9px;"/>
                    </StackPane>
                </StackPane>

                <Label text="●   ESTADO DEL TURNO · ACTIVO" styleClass="abrir-caja-kicker-pill"/>

                <Label text="La caja de hoy ya fue abierta"
                       styleClass="abrir-caja-card-title" wrapText="true" textAlignment="CENTER"/>

                <Label text="El turno operativo ya se encuentra iniciado y listo para recibir clientes en mostrador."
                       styleClass="abrir-caja-card-subtitle" wrapText="true" textAlignment="CENTER" maxWidth="400"/>

                <!-- Tarjeta resumen de apertura -->
                <VBox spacing="8" styleClass="abrir-caja-alert-box">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <StackPane minWidth="24" minHeight="24" maxWidth="24" maxHeight="24"
                                   styleClass="abrir-caja-icon-amber-circle">
                            <Label text="i" style="-fx-text-fill: #FAF6F0; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                        </StackPane>
                        <Label fx:id="lblResumenCajaAbierta"
                               text="La caja ya está abierta desde las 8:15 a. m., con base de $ 50.000."
                               wrapText="true" maxWidth="380"
                               styleClass="abrir-caja-alert-headline"/>
                    </HBox>

                    <Label fx:id="lblAbiertaPor"
                           text="     👤  Abierta por: Doña Rosita (Apertura matutina)"
                           styleClass="abrir-caja-alert-detail"/>
                    <Label text="     💵  Efectivo verificado"
                           styleClass="abrir-caja-alert-detail"/>

                    <Separator/>

                    <Label text="🕒  Puede ingresar al mostrador a registrar ventas inmediatamente."
                           styleClass="abrir-caja-alert-subnote"/>
                </VBox>

                <!-- 2 Tarjetas de Puesto y Turno -->
                <HBox spacing="12">
                    <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS" styleClass="abrir-caja-mini-card">
                        <StackPane styleClass="abrir-caja-mini-icon">
                            <Label text="🏪" style="-fx-font-size: 13px; -fx-text-fill: #704214;"/>
                        </StackPane>
                        <VBox spacing="1">
                            <Label text="Puesto actual" styleClass="abrir-caja-mini-label"/>
                            <Label text="Caja Principal 01" styleClass="abrir-caja-mini-value"/>
                        </VBox>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS" styleClass="abrir-caja-mini-card">
                        <StackPane styleClass="abrir-caja-mini-icon">
                            <Label text="🧾" style="-fx-font-size: 13px; -fx-text-fill: #704214;"/>
                        </StackPane>
                        <VBox spacing="1">
                            <Label text="Turno del día" styleClass="abrir-caja-mini-label"/>
                            <Label text="Jornada Continua" styleClass="abrir-caja-mini-value"/>
                        </VBox>
                    </HBox>
                </HBox>

                <Button fx:id="btnIrAVenderYaAbierta" text="🛒   Ir a Vender   →"
                        onAction="#handleIrAVender"
                        maxWidth="Infinity" styleClass="abrir-caja-btn-primary"/>

                <Button text="←   Volver al Menú Principal"
                        onAction="#handleVolverMenu"
                        maxWidth="Infinity" styleClass="abrir-caja-btn-secondary"/>

                <HBox alignment="CENTER" spacing="8">
                    <Label text="ENTER" styleClass="abrir-caja-enter-badge"/>
                    <Label text="Presione Enter para ir directamente al mostrador de ventas"
                           styleClass="abrir-caja-footnote"/>
                </HBox>
            </VBox>

            <!-- ==========================================================
                 ESTADO 3: FORMULARIO DE APERTURA DE TURNO
                 ========================================================== -->
            <VBox fx:id="panelFormularioApertura" alignment="CENTER_LEFT" spacing="15"
                  maxWidth="470" maxHeight="-Infinity" visible="true" managed="true"
                  styleClass="abrir-caja-card">

                <Label text="🔓  APERTURA DE TURNO" styleClass="abrir-caja-kicker-pill"/>

                <Label text="¿Con cuánto dinero empieza la caja hoy?"
                       styleClass="abrir-caja-card-title-left" wrapText="true"/>

                <Label text="Cuente los billetes y las monedas que hay en el cajón y escriba el total."
                       styleClass="abrir-caja-card-subtitle-left" wrapText="true"/>

                <VBox spacing="6">
                    <Label text="Monto inicial en efectivo" styleClass="abrir-caja-field-label"/>

                    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="abrir-caja-input-box">
                        <Label text="\$" styleClass="abrir-caja-input-prefix"/>
                        <TextField fx:id="txtMontoInicial" promptText="50.000"
                                   HBox.hgrow="ALWAYS" styleClass="abrir-caja-input-field"/>
                        <Button fx:id="btnBorrarMonto" text="⌫" onAction="#handleLimpiarMontoInicial"
                                styleClass="abrir-caja-btn-clear"/>
                    </HBox>
                </VBox>

                <Label fx:id="lblErrorMonto"
                       text="⚠ Escriba un monto inicial válido mayor o igual a $ 0."
                       visible="false" managed="false"
                       styleClass="abrir-caja-error-inline"/>

                <!-- Nota informativa consultando el ultimo cierre en MySQL -->
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="abrir-caja-ref-strip">
                    <Label text="🕒" style="-fx-font-size: 13px; -fx-text-fill: #704214;"/>
                    <Label fx:id="lblUltimoCierreInfo"
                           text="Ayer la caja se cerró con $ 250.000 contados."
                           wrapText="true" styleClass="abrir-caja-ref-text"/>
                </HBox>

                <Button fx:id="btnConfirmarApertura" text="✓   Abrir caja"
                        onAction="#handleConfirmarApertura"
                        maxWidth="Infinity" styleClass="abrir-caja-btn-primary">
                    <VBox.margin>
                        <Insets top="2"/>
                    </VBox.margin>
                </Button>

                <Button text="←   Volver al Menú"
                        onAction="#handleVolverMenu"
                        maxWidth="Infinity" styleClass="abrir-caja-btn-secondary"/>
            </VBox>

            <!-- ==========================================================
                 ESTADO 4: CONFIRMACION DE APERTURA EXITOSA ("¡Caja abierta!")
                 ========================================================== -->
            <VBox fx:id="panelAperturaExitosa" alignment="TOP_CENTER" spacing="16"
                  maxWidth="470" maxHeight="-Infinity" visible="false" managed="false"
                  styleClass="abrir-caja-card">

                <Label text="✓   APERTURA DE TURNO EXITOSA" styleClass="abrir-caja-kicker-pill"/>

                <!-- Icono circular doble con check -->
                <StackPane minWidth="68" minHeight="68" maxWidth="68" maxHeight="68">
                    <Circle radius="32" fill="#F8DEC6"/>
                    <Circle radius="20" fill="#46220F"/>
                    <Label text="✓" style="-fx-text-fill: #FAF6F0; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <StackPane StackPane.alignment="TOP_RIGHT" minWidth="18" minHeight="18" maxWidth="18" maxHeight="18"
                               style="-fx-background-color: #704214; -fx-background-radius: 9px;">
                        <Label text="✓" style="-fx-text-fill: #FAF6F0; -fx-font-size: 9px; -fx-font-weight: bold;"/>
                    </StackPane>
                </StackPane>

                <Label text="¡Caja abierta!" styleClass="abrir-caja-success-title"/>

                <Label text="El turno ha sido registrado correctamente y la caja se encuentra lista para atender en mostrador."
                       styleClass="abrir-caja-card-subtitle" wrapText="true" textAlignment="CENTER" maxWidth="380"/>

                <!-- Franja de Base inicial y hora -->
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="abrir-caja-base-strip">
                    <Label text="💵   Base inicial:" styleClass="abrir-caja-base-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblExitoMontoBase" text="\$ 50.000" styleClass="abrir-caja-base-amount"/>
                    <Label fx:id="lblExitoHora" text="· 8:15 a. m." styleClass="abrir-caja-base-time"/>
                </HBox>

                <!-- Datos reales de Cajera en turno y Turno N° -->
                <HBox alignment="CENTER_LEFT" spacing="32" maxWidth="390" style="-fx-padding: 2 8 2 8;">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Cajera en turno" styleClass="abrir-caja-mini-label"/>
                        <Label fx:id="lblExitoCajera" text="Gladys" styleClass="abrir-caja-mini-value"/>
                    </VBox>
                    <VBox spacing="2">
                        <Label text="Turno N°" styleClass="abrir-caja-mini-label"/>
                        <Label fx:id="lblExitoTurnoCodigo" text="TRN-2026-0001" styleClass="abrir-caja-mini-value"/>
                    </VBox>
                </HBox>

                <Button fx:id="btnIrAVenderExito" text="🛒   Ir a Vender   →"
                        onAction="#handleIrAVender"
                        maxWidth="Infinity" styleClass="abrir-caja-btn-primary"/>

                <Button text="←   Volver al Menú"
                        onAction="#handleVolverMenu"
                        maxWidth="Infinity" styleClass="abrir-caja-btn-ghost"/>

                <HBox alignment="CENTER" spacing="8">
                    <Label text="ENTER" styleClass="abrir-caja-enter-badge"/>
                    <Label text="Presione Enter para ir directo al mostrador de ventas"
                           styleClass="abrir-caja-footnote"/>
                </HBox>
            </VBox>

        </StackPane>
    </center>

    <!-- ==================================================================
         PIE DE PAGINA DE TERMINAL Y VERSION
         ================================================================== -->
    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="abrir-caja-footer">
            <padding>
                <Insets top="4" right="28" bottom="10" left="28"/>
            </padding>
            <Label text="Terminal: CAJA-01 · Sucursal Centro" styleClass="abrir-caja-footer-text"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Sistema de Punto de Venta CONARY © 2026" styleClass="abrir-caja-footer-text"/>
        </HBox>
    </bottom>

</BorderPane>
