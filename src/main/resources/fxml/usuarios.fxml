<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.conary.rosita.controller.UsuariosController"
            fx:id="rootPane"
            styleClass="clientes-root"
            maxWidth="Infinity" maxHeight="Infinity">

    <!-- ==================================================================
         CABECERA ESTANDAR LIMPIA DE CONARY: USUARIOS Y CLAVES
         ================================================================== -->
    <top>
        <VBox spacing="0">
            <padding>
                <Insets top="10" right="18" bottom="8" left="18"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="14" styleClass="clientes-header-bar">
                <Button fx:id="btnVolverMasOpciones" text="←   Volver a Más opciones"
                        onAction="#handleVolverAMasOpciones"
                        styleClass="clientes-btn-volver"/>

                <StackPane styleClass="clientes-header-icon-box">
                    <SVGPath fill="#704214"
                             content="M 0 -5 C -2.2 -5 -4 -3.2 -4 -1 C -4 1.2 -2.2 3 0 3 C 2.2 3 4 1.2 4 -1 C 4 -3.2 2.2 -5 0 -5 Z M 0 5 C -3.8 5 -7.2 6.8 -7.2 9.5 L 7.2 9.5 C 7.2 6.8 3.8 5 0 5 Z"/>
                </StackPane>

                <Label text="Usuarios y claves" styleClass="clientes-header-title"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="🛡  Acceso restringido para administración"
                       styleClass="usuarios-restricted-pill"/>

                <!-- Capsula de Usuario en Sesion Real -->
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="clientes-user-pill">
                    <StackPane>
                        <Circle radius="14" fill="#5C300C"/>
                        <SVGPath fill="#FAF6F0"
                                 content="M 0 -5 C -2.2 -5 -4 -3.2 -4 -1 C -4 1.2 -2.2 3 0 3 C 2.2 3 4 1.2 4 -1 C 4 -3.2 2.2 -5 0 -5 Z M 0 5 C -3.5 5 -7 6.8 -7 9.5 L 7 9.5 C 7 6.8 3.5 5 0 5 Z"/>
                    </StackPane>
                    <Label fx:id="lblUsuarioHeader" text="Doña Rosita · Administradora"
                           styleClass="clientes-user-text"/>
                </HBox>
            </HBox>
        </VBox>
    </top>

    <!-- ==================================================================
         CONTENIDO CENTRAL: FILTROS, ACCION SUPERIOR, TABLA Y PIE
         ================================================================== -->
    <center>
        <VBox spacing="10" VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="2" right="18" bottom="8" left="18"/>
            </padding>

            <!-- Barra de Filtros y Boton Registrar Usuario Nuevo -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <ToggleButton fx:id="tbFiltroActivos" text="✓   Activos (0)" selected="true"
                              styleClass="clientes-filter-pill"/>
                <ToggleButton fx:id="tbFiltroDadosBaja" text="📦   Dados de baja (0)"
                              styleClass="clientes-filter-pill"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="btnRegistrarUsuario" text="+   Registrar usuario nuevo"
                        onAction="#handleRegistrarUsuarioNuevo"
                        styleClass="clientes-btn-registrar"/>
            </HBox>

            <!-- Tabla Principal de 4 Columnas y Pie -->
            <VBox spacing="0" VBox.vgrow="ALWAYS" styleClass="clientes-table-card">
                <TableView fx:id="tblUsuarios" VBox.vgrow="ALWAYS" styleClass="clientes-table">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colNombre" text="Nombre" prefWidth="260" minWidth="180"/>
                        <TableColumn fx:id="colUsuario" text="Usuario" prefWidth="200" minWidth="140"/>
                        <TableColumn fx:id="colRol" text="Qué puede hacer" prefWidth="210" minWidth="150"/>
                        <TableColumn fx:id="colEstado" text="Estado" prefWidth="160" minWidth="120"/>
                    </columns>
                    <placeholder>
                        <VBox alignment="CENTER" spacing="6" style="-fx-padding: 32;">
                            <Label text="No hay usuarios para mostrar en esta categoría."
                                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #6B4C35;"/>
                        </VBox>
                    </placeholder>
                </TableView>

                <!-- Pie de Tabla -->
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="clientes-footer-bar">
                    <Label text="ℹ  Por seguridad de la papelería, las contraseñas nunca se muestran en pantalla ni se comparten."
                           wrapText="true" styleClass="clientes-footer-count"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblTotalRegistrados" text="Total: 0 personas registradas"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #46220F;"/>
                </HBox>
            </VBox>
        </VBox>
    </center>

    <!-- ==================================================================
         BARRA INFERIOR FIJA: USUARIO EN GESTION
         ================================================================== -->
    <bottom>
        <VBox spacing="6">
            <padding>
                <Insets top="0" right="18" bottom="10" left="18"/>
            </padding>

            <HBox fx:id="barraGestionUsuario" alignment="CENTER_LEFT" spacing="12"
                  styleClass="clientes-selection-bar">
                <StackPane styleClass="clientes-selection-icon-box">
                    <SVGPath fill="#704214"
                             content="M 0 -4.5 C -2 -4.5 -3.6 -2.9 -3.6 -0.9 C -3.6 1.1 -2 2.7 0 2.7 C 2 2.7 3.6 1.1 3.6 -0.9 C 3.6 -2.9 2 -4.5 0 -4.5 Z M 0 4.5 C -3.4 4.5 -6.5 6.2 -6.5 8.5 L 6.5 8.5 C 6.5 6.2 3.4 4.5 0 4.5 Z"/>
                </StackPane>

                <VBox spacing="1" HBox.hgrow="ALWAYS">
                    <Label text="USUARIO EN GESTIÓN" styleClass="modal-abono-kicker"/>
                    <Label fx:id="lblUsuarioSeleccionadoInfo"
                           text="Seleccione una persona de la lista para gestionar su cuenta"
                           styleClass="clientes-selection-text"/>
                </VBox>

                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <Button fx:id="btnCambiarClave" text="🔑   Cambiar clave"
                            onAction="#handleCambiarClave"
                            styleClass="clientes-btn-ver-cuenta"/>

                    <Button fx:id="btnModificarUsuario" text="✎   Modificar datos"
                            onAction="#handleModificarUsuario"
                            styleClass="clientes-btn-action-outline"/>

                    <Button fx:id="btnDarBajaUsuario" text="📦   Dar de baja"
                            onAction="#handleDarBajaUsuario"
                            styleClass="usuarios-btn-baja"/>
                </HBox>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="8">
                <Circle radius="4" fill="#704214"/>
                <Label text="Datos guardados en este equipo" styleClass="clientes-footer-saved"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Papelería de Rosita · CONARY v1.0" styleClass="clientes-footer-saved"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>