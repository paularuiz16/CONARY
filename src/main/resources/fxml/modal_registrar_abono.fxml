<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<StackPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.conary.rosita.controller.RegistrarAbonoController"
           styleClass="modal-abono-root">

    <VBox spacing="15" prefWidth="480" maxWidth="480" styleClass="modal-abono-card">

        <!-- Cabecera: Icono cuadrado melocoton con billete + titulo -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <StackPane styleClass="modal-abono-icon-box">
                <SVGPath fill="transparent" stroke="#704214" strokeWidth="1.6"
                         content="M 1 3 L 15 3 L 15 12 L 1 12 Z M 8 5.5 C 6.9 5.5 6 6.4 6 7.5 C 6 8.6 6.9 9.5 8 9.5 C 9.1 9.5 10 8.6 10 7.5 C 10 6.4 9.1 5.5 8 5.5 Z"/>
            </StackPane>
            <Label text="Registrar abono" styleClass="modal-abono-title"/>
        </HBox>

        <!-- Tarjeta de Cliente y Estado de Cuenta -->
        <HBox alignment="CENTER_LEFT" styleClass="modal-abono-client-card">
            <VBox spacing="2">
                <Label text="CLIENTE" styleClass="modal-abono-kicker"/>
                <Label fx:id="lblNombreCliente" text="María Gómez" styleClass="modal-abono-client-name"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox spacing="2" alignment="CENTER_RIGHT">
                <Label text="ESTADO DE CUENTA" styleClass="modal-abono-kicker"/>
                <HBox alignment="CENTER_RIGHT" spacing="6">
                    <Label text="Debe ahora:" styleClass="modal-abono-debe-label"/>
                    <Label fx:id="lblDeudaActual" text="\$ 0" styleClass="modal-abono-debe-value"/>
                </HBox>
            </VBox>
        </HBox>

        <!-- Banner de Validacion del Monto (oculto por defecto) -->
        <HBox fx:id="boxAlertaMonto" alignment="CENTER_LEFT" spacing="8"
              visible="false" managed="false" styleClass="modal-abono-alert">
            <Label fx:id="lblAlertaMonto" text="⚠  No puede pagar más de lo que debe."
                   wrapText="true" styleClass="modal-abono-alert-text"/>
        </HBox>

        <!-- Campo de Monto -->
        <VBox spacing="6">
            <HBox alignment="CENTER_LEFT">
                <Label text="¿Cuánto paga hoy?" styleClass="modal-abono-field-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Escriba el dinero que le entrega" styleClass="modal-abono-field-help"/>
            </HBox>
            <HBox fx:id="boxInputMonto" alignment="CENTER_LEFT" spacing="6" styleClass="modal-abono-input-box">
                <Label text="\$" styleClass="modal-abono-input-prefix"/>
                <TextField fx:id="txtMontoAbono" promptText="0"
                           HBox.hgrow="ALWAYS" styleClass="modal-abono-input-field"/>
            </HBox>
        </VBox>

        <!-- Calculo Automatico del Saldo Restante -->
        <HBox fx:id="boxSaldoRestante" alignment="CENTER_LEFT" spacing="14" styleClass="modal-abono-saldo-box">
            <Label text="Saldo pendiente tras este pago:" wrapText="true" maxWidth="190"
                   styleClass="modal-abono-saldo-label"/>
            <Label fx:id="lblSaldoRestante" text="Quedará debiendo \$ 0." wrapText="true"
                   HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="modal-abono-saldo-value"/>
        </HBox>

        <!-- Nota Informativa -->
        <HBox alignment="CENTER_LEFT" spacing="8">
            <SVGPath fill="transparent" stroke="#704214" strokeWidth="1.4"
                     content="M 1 2 L 13 2 L 13 12 L 1 12 Z M 3.5 5 L 10.5 5 M 3.5 8 L 8 8"/>
            <Label fx:id="lblNotaCaja" text="Este dinero entra a la caja de hoy."
                   wrapText="true" styleClass="modal-abono-note"/>
        </HBox>

        <!-- Botones Inferiores -->
        <HBox spacing="12">
            <VBox.margin>
                <Insets top="2"/>
            </VBox.margin>
            <Button fx:id="btnCancelar" text="Cancelar" onAction="#handleCancelar"
                    maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="modal-abono-btn-cancel"/>
            <Button fx:id="btnGuardarAbono" text="✓   Guardar abono" onAction="#handleGuardarAbono"
                    maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="modal-abono-btn-save"/>
        </HBox>
    </VBox>
</StackPane>
