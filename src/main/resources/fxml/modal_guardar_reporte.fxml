<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<StackPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.conary.rosita.controller.GuardarReporteController"
           styleClass="modal-abono-root">

    <VBox spacing="14" prefWidth="480" maxWidth="480" styleClass="modal-abono-card">

        <!-- Cabecera: Icono melocoton con disquete + titulo -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <StackPane styleClass="modal-abono-icon-box">
                <SVGPath fill="transparent" stroke="#704214" strokeWidth="1.6"
                         content="M 2 2 L 11 2 L 14 5 L 14 14 L 2 14 Z M 4.5 2 L 4.5 6 L 10 6 L 10 2 M 4.5 9.5 L 11.5 9.5 L 11.5 14 L 4.5 14 Z"/>
            </StackPane>
            <Label text="Guardar reporte" styleClass="modal-abono-title"/>
        </HBox>

        <!-- Franja Resumen del Reporte -->
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="modal-abono-client-card">
            <SVGPath fill="transparent" stroke="#704214" strokeWidth="1.5"
                     content="M 1 2 L 3.2 2 L 5.2 9.5 L 12.5 9.5 L 14 4 L 4 4 M 6 12.5 C 6 13.1 5.5 13.5 5 13.5 C 4.5 13.5 4 13.1 4 12.5 M 12 12.5 C 12 13.1 11.5 13.5 11 13.5 C 10.5 13.5 10 13.1 10 12.5"/>
            <Label fx:id="lblResumenReporte" text="Ventas · del 20 al 24 de octubre de 2026"
                   wrapText="true" styleClass="modal-abono-client-name"/>
        </HBox>

        <!-- Banner Verde de Confirmacion (oculto hasta guardar) -->
        <HBox fx:id="boxReporteGuardado" alignment="CENTER_LEFT" spacing="8"
              visible="false" managed="false" styleClass="modal-guardar-success-banner">
            <Label fx:id="lblMensajeGuardado" text="✓  Reporte guardado en Documentos."
                   wrapText="true" styleClass="modal-guardar-success-text"/>
        </HBox>

        <!-- Selector: ¿En que formato? -->
        <VBox spacing="7">
            <Label text="¿En qué formato?" styleClass="modal-abono-field-label"/>
            <HBox spacing="10">
                <ToggleButton fx:id="tbFormatoPdf" text="📄   PDF   ✓" selected="true"
                              maxWidth="Infinity" HBox.hgrow="ALWAYS"
                              styleClass="compra-origin-toggle"/>
                <ToggleButton fx:id="tbFormatoExcel" text="📊   Excel"
                              maxWidth="Infinity" HBox.hgrow="ALWAYS"
                              styleClass="compra-origin-toggle"/>
            </HBox>
        </VBox>

        <!-- Selector: ¿Donde se guarda? -->
        <VBox spacing="7">
            <Label text="¿Dónde se guarda?" styleClass="modal-abono-field-label"/>
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="modal-guardar-folder-box">
                <SVGPath fill="#704214"
                         content="M 1 3 C 1 2.4 1.4 2 2 2 L 6 2 L 7.5 3.5 L 13 3.5 C 13.6 3.5 14 3.9 14 4.5 L 14 12 C 14 12.6 13.6 13 13 13 L 2 13 C 1.4 13 1 12.6 1 12 Z"/>
                <Label fx:id="lblRutaCarpeta" text="Carpeta Documentos de este equipo"
                       wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                       styleClass="modal-abono-note"/>
                <Button fx:id="btnCambiarCarpeta" text="Cambiar" onAction="#handleCambiarCarpeta"
                        styleClass="modal-guardar-btn-cambiar"/>
            </HBox>
        </VBox>

        <!-- Botones Inferiores -->
        <HBox spacing="12">
            <VBox.margin>
                <Insets top="4"/>
            </VBox.margin>
            <Button fx:id="btnGuardar" text="✓   Guardar" onAction="#handleGuardar"
                    maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="modal-abono-btn-save"/>
            <Button fx:id="btnCancelar" text="Cancelar" onAction="#handleCancelar"
                    styleClass="modal-abono-btn-cancel"/>
        </HBox>

    </VBox>
</StackPane>