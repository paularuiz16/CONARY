<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.conary.rosita.controller.ClientesController"
            fx:id="rootPane"
            styleClass="clientes-root"
            maxWidth="Infinity" maxHeight="Infinity">

    <!-- ==================================================================
         ENCABEZADO SUPERIOR DE CLIENTES Y FIADO
         ================================================================== -->
    <top>
        <VBox spacing="0">
            <padding>
                <Insets top="10" right="18" bottom="8" left="18"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="14" styleClass="clientes-header-bar">
                <Button fx:id="btnVolverMenu" text="←   Volver al Menú"
                        onAction="#handleVolverMenu"
                        styleClass="clientes-btn-volver"/>

                <StackPane styleClass="clientes-header-icon-box">
                    <SVGPath fill="transparent" stroke="#704214" strokeWidth="1.6"
                             content="M 1 2.5 C 3 1.5 5.5 1.5 7.5 2.8 C 9.5 1.5 12 1.5 14 2.5 L 14 12.5 C 12 11.5 9.5 11.5 7.5 12.8 C 5.5 11.5 3 11.5 1 12.5 Z M 7.5 2.8 L 7.5 12.8"/>
                </StackPane>

                <Label text="Clientes y fiado" styleClass="clientes-header-title"/>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Capsula de Usuario en Sesion Real -->
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="clientes-user-pill">
                    <StackPane>
                        <Circle radius="14" fill="#5C300C"/>
                        <SVGPath fill="#FAF6F0"
                                 content="M 0 -5 C -2.2 -5 -4 -3.2 -4 -1 C -4 1.2 -2.2 3 0 3 C 2.2 3 4 1.2 4 -1 C 4 -3.2 2.2 -5 0 -5 Z M 0 5 C -3.5 5 -7 6.8 -7 9.5 L 7 9.5 C 7 6.8 3.5 5 0 5 Z"/>
                    </StackPane>
                    <Label fx:id="lblUsuarioHeader" text="Doña Rosita · Administradora"
                           styleClass="clientes-user-text"/>
                </HBox>
            </HBox>
        </VBox>
    </top>

    <!-- ==================================================================
         CONTENIDO CENTRAL: BUSCADOR, FILTROS, INDICADORES Y TABLA
         ================================================================== -->
    <center>
        <VBox spacing="10" VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="0" right="18" bottom="8" left="18"/>
            </padding>

            <!-- 1. Barra de Busqueda, 4 Pildoras de Filtro y Boton Registrar -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <HBox alignment="CENTER_LEFT" spacing="8" HBox.hgrow="ALWAYS"
                      styleClass="clientes-search-box">
                    <SVGPath fill="transparent" stroke="#7A5B43" strokeWidth="1.6"
                             content="M 6 1 C 3.24 1 1 3.24 1 6 C 1 8.76 3.24 11 6 11 C 8.76 11 11 8.76 11 6 C 11 3.24 8.76 1 6 1 Z M 9.8 9.8 L 13.5 13.5"/>
                    <TextField fx:id="txtBuscarCliente" promptText="Buscar por nombre..."
                               HBox.hgrow="ALWAYS" styleClass="clientes-search-input"/>
                </HBox>

                <ToggleButton fx:id="tbFiltroTodos" text="Todos" selected="true"
                              styleClass="clientes-filter-pill"/>
                <ToggleButton fx:id="tbFiltroConDeuda" text="Con deuda"
                              styleClass="clientes-filter-pill"/>
                <ToggleButton fx:id="tbFiltroConFiado" text="Con fiado autorizado"
                              styleClass="clientes-filter-pill"/>
                <ToggleButton fx:id="tbFiltroDadosBaja" text="Dados de baja"
                              styleClass="clientes-filter-pill"/>

                <Button fx:id="btnRegistrarCliente" text="👤+   + Registrar cliente nuevo"
                        onAction="#handleRegistrarClienteNuevo"
                        styleClass="clientes-btn-registrar"/>
            </HBox>

            <!-- 2. 2 Tarjetas Superiores de Indicadores -->
            <HBox alignment="CENTER_LEFT" spacing="24" styleClass="clientes-kpi-strip">
                <HBox alignment="CENTER_LEFT" spacing="14" HBox.hgrow="ALWAYS">
                    <StackPane styleClass="clientes-kpi-icon-circle">
                        <SVGPath fill="transparent" stroke="#8C4A27" strokeWidth="1.6"
                                 content="M 1 3 L 15 3 L 15 12 L 1 12 Z M 8 5.5 C 6.9 5.5 6 6.4 6 7.5 C 6 8.6 6.9 9.5 8 9.5 C 9.1 9.5 10 8.6 10 7.5 C 10 6.4 9.1 5.5 8 5.5 Z"/>
                    </StackPane>
                    <VBox spacing="1">
                        <Label text="Le deben en total" styleClass="clientes-kpi-label"/>
                        <Label fx:id="lblTotalDeudaActivos" text="\$ 0" styleClass="clientes-kpi-value"/>
                    </VBox>
                </HBox>

                <Separator orientation="VERTICAL" prefHeight="40"/>

                <HBox alignment="CENTER_LEFT" spacing="14" HBox.hgrow="ALWAYS">
                    <StackPane styleClass="clientes-kpi-icon-circle">
                        <SVGPath fill="transparent" stroke="#8C4A27" strokeWidth="1.6"
                                 content="M 7 1 L 2 3.2 L 2 7 C 2 10.2 4.1 12.8 7 13.6 C 9.9 12.8 12 10.2 12 7 L 12 3.2 Z M 4.8 7.2 L 6.4 8.8 L 9.4 5.6"/>
                    </StackPane>
                    <VBox spacing="1">
                        <Label text="Clientes con fiado autorizado" styleClass="clientes-kpi-label"/>
                        <Label fx:id="lblConteoFiadoAutorizado" text="0" styleClass="clientes-kpi-value"/>
                    </VBox>
                </HBox>
            </HBox>

            <!-- 3. Tabla Principal de Clientes y Pie de Paginacion -->
            <VBox spacing="0" VBox.vgrow="ALWAYS" styleClass="clientes-table-card">
                <TableView fx:id="tblClientes" VBox.vgrow="ALWAYS" styleClass="clientes-table">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colNombre" text="Nombre" prefWidth="255" minWidth="180"/>
                        <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="150" minWidth="120" maxWidth="190"/>
                        <TableColumn fx:id="colFiado" text="Fiado" prefWidth="135" minWidth="110" maxWidth="165"/>
                        <TableColumn fx:id="colCupo" text="Cupo" prefWidth="145" minWidth="115" maxWidth="175"/>
                        <TableColumn fx:id="colDebeAhora" text="Debe ahora" prefWidth="150" minWidth="120" maxWidth="180"/>
                        <TableColumn fx:id="colAviso" text="Aviso" prefWidth="155" minWidth="130" maxWidth="185"/>
                    </columns>
                    <placeholder>
                        <VBox alignment="CENTER" spacing="6" style="-fx-padding: 32;">
                            <Label text="No se encontraron clientes con el filtro seleccionado."
                                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #6B4C35;"/>
                            <Label text="Puede registrar un cliente nuevo con el botón superior derecho."
                                   style="-fx-font-size: 13px; -fx-text-fill: #8D7B6A;"/>
                        </VBox>
                    </placeholder>
                </TableView>

                <!-- Pie de Tabla: Conteo y Paginacion -->
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="clientes-footer-bar">
                    <SVGPath fill="transparent" stroke="#704214" strokeWidth="1.5"
                             content="M 1 3 L 3 3 M 5 3 L 13 3 M 1 7 L 3 7 M 5 7 L 13 7 M 1 11 L 3 11 M 5 11 L 13 11"/>
                    <Label fx:id="lblConteoClientes" text="Mostrando 0 de 0 clientes"
                           styleClass="clientes-footer-count"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <SVGPath fill="transparent" stroke="#7A5B43" strokeWidth="1.4"
                                 content="M 1 2 L 11 2 L 11 9 L 1 9 Z M 4 12 L 8 12 M 6 9 L 6 12"/>
                        <Label text="Datos guardados en este equipo" styleClass="clientes-footer-saved"/>
                    </HBox>

                    <Button fx:id="btnPaginaAnterior" text="← Anterior"
                            onAction="#handlePaginaAnterior"
                            styleClass="clientes-btn-page"/>
                    <Button fx:id="btnPaginaSiguiente" text="Siguiente →"
                            onAction="#handlePaginaSiguiente"
                            styleClass="clientes-btn-page"/>
                </HBox>
            </VBox>

        </VBox>
    </center>

    <!-- ==================================================================
         BARRA INFERIOR FIJA DE SELECCION Y 4 BOTONES CONTEXTUALES
         ================================================================== -->
    <bottom>
        <VBox spacing="0">
            <padding>
                <Insets top="0" right="18" bottom="10" left="18"/>
            </padding>

            <HBox fx:id="barraSeleccionCliente" alignment="CENTER_LEFT" spacing="10"
                  styleClass="clientes-selection-bar">
                <StackPane styleClass="clientes-selection-icon-box">
                    <SVGPath fill="transparent" stroke="#8C4A27" strokeWidth="1.5"
                             content="M 3 2 L 11 2 L 11 13 L 3 13 Z M 5 1 L 9 1 L 9 3 L 5 3 Z M 5 6 L 9 6 M 5 9 L 8 9"/>
                </StackPane>

                <Label fx:id="lblClienteSeleccionadoInfo"
                       text="Seleccione un cliente de la tabla para ver sus opciones"
                       wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                       styleClass="clientes-selection-text"/>

                <HBox alignment="CENTER_RIGHT" spacing="8">
                    <Button fx:id="btnVerCuenta" text="📖   Ver cuenta"
                            onAction="#handleVerCuenta"
                            styleClass="clientes-btn-ver-cuenta"/>

                    <Button fx:id="btnRegistrarAbono" text="💵   Registrar abono"
                            onAction="#handleRegistrarAbono"
                            styleClass="clientes-btn-action-outline"/>

                    <Button fx:id="btnAutorizarFiado" text="✓   Autorizar fiado"
                            onAction="#handleAutorizarFiado"
                            styleClass="clientes-btn-action-outline"/>

                    <Button fx:id="btnModificarCliente" text="✎   Modificar datos"
                            onAction="#handleModificarCliente"
                            styleClass="clientes-btn-action-outline"/>
                </HBox>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
