<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.conary.rosita.controller.RegistrarProveedorController"
            fx:id="rootPane"
            styleClass="reg-cliente-root"
            maxWidth="Infinity" maxHeight="Infinity">

    <!-- ==================================================================
         ENCABEZADO SUPERIOR DE REGISTRAR PROVEEDOR
         ================================================================== -->
    <top>
        <VBox spacing="0">
            <padding>
                <Insets top="10" right="22" bottom="8" left="22"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="14" styleClass="reg-cliente-header-bar">
                <Button fx:id="btnVolverProveedores" text="←   Volver a Proveedores"
                        onAction="#handleVolverAProveedores"
                        styleClass="clientes-btn-volver"/>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Capsula de Usuario en Sesion Real -->
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="reg-cliente-user-pill">
                    <VBox alignment="CENTER_RIGHT" spacing="0">
                        <Label fx:id="lblUsuarioNombre" text="Doña Rosita" styleClass="reg-cliente-user-name"/>
                        <Label fx:id="lblUsuarioRol" text="Administradora" styleClass="reg-cliente-user-role"/>
                    </VBox>
                    <StackPane>
                        <Circle radius="14" fill="#5C300C"/>
                        <SVGPath fill="#FAF6F0"
                                 content="M 0 -5 C -2.2 -5 -4 -3.2 -4 -1 C -4 1.2 -2.2 3 0 3 C 2.2 3 4 1.2 4 -1 C 4 -3.2 2.2 -5 0 -5 Z M 0 5 C -3.5 5 -7 6.8 -7 9.5 L 7 9.5 C 7 6.8 3.5 5 0 5 Z"/>
                    </StackPane>
                </HBox>
            </HBox>
        </VBox>
    </top>

    <!-- ==================================================================
         TARJETA CENTRAL BLANCA DE REGISTRO DE PROVEEDOR
         ================================================================== -->
    <center>
        <StackPane maxWidth="Infinity" maxHeight="Infinity">
            <padding>
                <Insets top="8" right="24" bottom="14" left="24"/>
            </padding>

            <VBox spacing="16" maxWidth="590" maxHeight="-Infinity"
                  styleClass="reg-proveedor-card">

                <!-- Cabecera Interna de la Tarjeta -->
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <StackPane styleClass="modal-abono-icon-box">
                        <SVGPath fill="#704214"
                                 content="M 0 -5 C -2.4 -5 -4.2 -3.2 -4.2 -0.8 C -4.2 1.6 -2.4 3.4 0 3.4 C 2.4 3.4 4.2 1.6 4.2 -0.8 C 4.2 -3.2 2.4 -5 0 -5 Z M -7.5 9.5 C -7.5 6.2 -4 4.5 0 4.5 C 4 4.5 7.5 6.2 7.5 9.5 Z M 7.5 -2 L 13.5 -2 M 10.5 -5 L 10.5 1"/>
                    </StackPane>
                    <VBox spacing="2">
                        <Label text="Registrar proveedor" styleClass="reg-proveedor-title"/>
                        <Label text="Complete los datos clave para mantener el directorio al día"
                               styleClass="reg-proveedor-subtitle"/>
                    </VBox>
                </HBox>

                <!-- Banner Superior de Validacion de Duplicado (oculto por defecto) -->
                <HBox fx:id="boxAlertaDuplicado" alignment="CENTER_LEFT" spacing="12"
                      visible="false" managed="false"
                      styleClass="reg-cliente-alert-duplicate">
                    <SVGPath fill="transparent" stroke="#8C4A27" strokeWidth="1.9"
                             content="M 0 -9 L 10 8 L -10 8 Z M 0 -3 L 0 2.5 M 0 5.5 L 0 6.2"/>
                    <Label fx:id="lblTextoDuplicado"
                           text="Ya hay un proveedor con este nombre: Distribuciones Andina. Cambie el nombre o vuelva a la lista."
                           wrapText="true" maxWidth="480"
                           styleClass="reg-cliente-alert-duplicate-text"/>
                </HBox>

                <!-- Campo 1: Nombre del proveedor * (Obligatorio) -->
                <VBox spacing="6">
                    <HBox alignment="CENTER_LEFT" spacing="4">
                        <Label text="Nombre del proveedor" styleClass="reg-cliente-field-label"/>
                        <Label text="*" style="-fx-text-fill: #C92A2A; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Obligatorio" styleClass="reg-proveedor-required-pill"/>
                    </HBox>

                    <HBox fx:id="boxInputNombre" alignment="CENTER_LEFT" spacing="8"
                          styleClass="reg-proveedor-input-box">
                        <TextField fx:id="txtNombreProveedor"
                                   promptText="Ej: Distribuciones Andina"
                                   HBox.hgrow="ALWAYS"
                                   styleClass="reg-proveedor-input-field"/>
                    </HBox>

                    <Label fx:id="lblAyudaNombre"
                           text="ⓘ  Como lo conoce usted"
                           styleClass="reg-cliente-field-help"/>
                </VBox>

                <!-- Campo 2: Telefono -->
                <VBox spacing="6">
                    <Label text="Teléfono" styleClass="reg-cliente-field-label"/>

                    <HBox fx:id="boxInputTelefono" alignment="CENTER_LEFT" spacing="8"
                          styleClass="reg-proveedor-input-box">
                        <TextField fx:id="txtTelefonoProveedor"
                                   promptText="Ej: 320 555 0111"
                                   HBox.hgrow="ALWAYS"
                                   styleClass="reg-proveedor-input-field"/>
                    </HBox>

                    <Label text="📞  Para hacerle los pedidos"
                           styleClass="reg-cliente-field-help"/>
                </VBox>

                <!-- Campo 3: Que le compra -->
                <VBox spacing="6">
                    <Label text="Qué le compra" styleClass="reg-cliente-field-label"/>

                    <HBox fx:id="boxInputProductos" alignment="CENTER_LEFT" spacing="8"
                          styleClass="reg-proveedor-input-box">
                        <TextField fx:id="txtProductosProveedor"
                                   promptText="Ej: Cuadernos y papel"
                                   HBox.hgrow="ALWAYS"
                                   styleClass="reg-proveedor-input-field"/>
                    </HBox>

                    <Label text="🗂  Escriba los productos o tipos de producto que le surte"
                           styleClass="reg-cliente-field-help"/>
                </VBox>

                <!-- Botones Inferiores -->
                <HBox alignment="CENTER_RIGHT" spacing="12">
                    <VBox.margin>
                        <Insets top="4"/>
                    </VBox.margin>

                    <Button fx:id="btnCancelar" text="✕   Cancelar"
                            onAction="#handleVolverAProveedores"
                            styleClass="reg-proveedor-btn-cancel"/>

                    <Button fx:id="btnGuardarProveedor" text="✓   Guardar proveedor"
                            onAction="#handleGuardarProveedor"
                            styleClass="reg-proveedor-btn-save"/>
                </HBox>

            </VBox>
        </StackPane>
    </center>

</BorderPane>