<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.conary.rosita.controller.ModificarClienteController"
            fx:id="rootPane"
            styleClass="reg-cliente-root"
            maxWidth="Infinity" maxHeight="Infinity">

    <!-- ==================================================================
         ENCABEZADO SUPERIOR DE MODIFICAR DATOS DEL CLIENTE
         ================================================================== -->
    <top>
        <VBox spacing="0">
            <padding>
                <Insets top="10" right="22" bottom="8" left="22"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="14" styleClass="reg-cliente-header-bar">
                <Button fx:id="btnVolverClientes" text="←   Volver a Clientes"
                        onAction="#handleVolverAClientes"
                        styleClass="reg-cliente-btn-volver"/>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox alignment="CENTER" spacing="10">
                    <SVGPath fill="transparent" stroke="#704214" strokeWidth="1.8"
                             content="M 10.5 1.5 L 13.5 4.5 L 4.5 13.5 L 1.5 13.5 L 1.5 10.5 Z M 8.5 3.5 L 11.5 6.5"/>
                    <Label text="Modificar datos" styleClass="reg-cliente-header-title"/>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Capsula de Usuario en Sesion Real -->
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="reg-cliente-user-pill">
                    <VBox alignment="CENTER_RIGHT" spacing="0">
                        <Label fx:id="lblUsuarioNombre" text="Doña Rosita" styleClass="reg-cliente-user-name"/>
                        <Label fx:id="lblUsuarioRol" text="Administradora" styleClass="reg-cliente-user-role"/>
                    </VBox>
                    <StackPane>
                        <Circle radius="14" fill="#5C300C"/>
                        <SVGPath fill="#FAF6F0"
                                 content="M 0 -5 C -2.2 -5 -4 -3.2 -4 -1 C -4 1.2 -2.2 3 0 3 C 2.2 3 4 1.2 4 -1 C 4 -3.2 2.2 -5 0 -5 Z M 0 5 C -3.5 5 -7 6.8 -7 9.5 L 7 9.5 C 7 6.8 3.5 5 0 5 Z"/>
                    </StackPane>
                </HBox>
            </HBox>
        </VBox>
    </top>

    <!-- ==================================================================
         TARJETA CENTRAL BLANCA DE EDICION DE DATOS DEL CLIENTE
         ================================================================== -->
    <center>
        <StackPane maxWidth="Infinity" maxHeight="Infinity">
            <padding>
                <Insets top="8" right="24" bottom="14" left="24"/>
            </padding>

            <VBox spacing="16" maxWidth="610" maxHeight="-Infinity"
                  styleClass="reg-cliente-card">

                <!-- Banner de Validacion de Duplicado contra otros clientes (oculto por defecto) -->
                <HBox fx:id="boxAlertaDuplicado" alignment="CENTER_LEFT" spacing="12"
                      visible="false" managed="false"
                      styleClass="reg-cliente-alert-duplicate">
                    <SVGPath fill="transparent" stroke="#8C4A27" strokeWidth="1.9"
                             content="M 0 -9 L 10 8 L -10 8 Z M 0 -3 L 0 2.5 M 0 5.5 L 0 6.2"/>
                    <Label fx:id="lblTextoDuplicado"
                           text="Ya hay otro cliente con este nombre: María Gómez · 310 555 0142. Cambie el nombre o vuelva a la lista."
                           wrapText="true" maxWidth="500"
                           styleClass="reg-cliente-alert-duplicate-text"/>
                </HBox>

                <!-- Campo 1: Nombre completo -->
                <VBox spacing="6">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Nombre completo" styleClass="reg-cliente-field-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Obligatorio" styleClass="reg-cliente-required-tag"/>
                    </HBox>

                    <HBox fx:id="boxInputNombre" alignment="CENTER_LEFT" spacing="8"
                          styleClass="reg-cliente-input-box">
                        <TextField fx:id="txtNombreCliente"
                                   promptText="Ej: María Gómez"
                                   HBox.hgrow="ALWAYS"
                                   styleClass="reg-cliente-input-field"/>
                        <SVGPath fill="transparent" stroke="#8D735B" strokeWidth="1.4"
                                 content="M 1 3 L 15 3 L 15 13 L 1 13 Z M 6 1 L 10 1 L 10 3 L 6 3 Z M 5 7 C 5 6.2 5.7 5.5 6.5 5.5 C 7.3 5.5 8 6.2 8 7 C 8 7.8 7.3 8.5 6.5 8.5 C 5.7 8.5 5 7.8 5 7 Z M 3.8 11 C 3.8 9.8 5 9.2 6.5 9.2 C 8 9.2 9.2 9.8 9.2 11 M 10.5 7 L 13 7 M 10.5 9.5 L 13 9.5"/>
                    </HBox>

                    <Label fx:id="lblAyudaNombre"
                           text="❓  Como lo conoce usted"
                           styleClass="reg-cliente-field-help"/>
                </VBox>

                <!-- Campo 2: Telefono -->
                <VBox spacing="6">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Teléfono" styleClass="reg-cliente-field-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Obligatorio" styleClass="reg-cliente-required-tag"/>
                    </HBox>

                    <HBox fx:id="boxInputTelefono" alignment="CENTER_LEFT" spacing="8"
                          styleClass="reg-cliente-input-box">
                        <TextField fx:id="txtTelefonoCliente"
                                   promptText="Ej: 310 555 0142"
                                   HBox.hgrow="ALWAYS"
                                   styleClass="reg-cliente-input-field"/>
                        <SVGPath fill="transparent" stroke="#8D735B" strokeWidth="1.5"
                                 content="M 3 1.5 L 5.5 1.5 L 6.8 4.8 L 5 6.2 C 6 8.2 7.8 10 9.8 11 L 11.2 9.2 L 14.5 10.5 L 14.5 13 C 14.5 13.8 13.8 14.5 13 14.5 C 6.6 14.5 1.5 9.4 1.5 3 C 1.5 2.2 2.2 1.5 3 1.5 Z"/>
                    </HBox>

                    <Label fx:id="lblAyudaTelefono"
                           text="ⓘ  Para localizarla si debe dinero"
                           styleClass="reg-cliente-field-help"/>
                </VBox>

                <!-- Franja Informativa de Fiado (Solo Lectura) -->
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="reg-cliente-info-strip">
                    <SVGPath fill="transparent" stroke="#704214" strokeWidth="1.5"
                             content="M 7 1 L 2 3.2 L 2 7 C 2 10.2 4.1 12.8 7 13.6 C 9.9 12.8 12 10.2 12 7 L 12 3.2 Z M 4.8 7.2 L 6.4 8.8 L 9.4 5.6"/>
                    <Label fx:id="lblInfoFiadoActual"
                           text="Fiado: autorizado, cupo $ 100.000. Para cambiarlo use Autorizar fiado."
                           wrapText="true" styleClass="reg-cliente-info-text"/>
                </HBox>

                <!-- Barra Inferior de Acciones dentro de la Tarjeta -->
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox.margin>
                        <Insets top="4"/>
                    </VBox.margin>

                    <Button fx:id="btnDarBajaCliente" text="📦   Dar de baja a este cliente"
                            onAction="#handleDarBajaCliente"
                            styleClass="mod-cliente-btn-baja"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button fx:id="btnCancelar" text="✕   Cancelar"
                            onAction="#handleVolverAClientes"
                            styleClass="reg-cliente-btn-cancel"/>

                    <Button fx:id="btnGuardarCambios" text="✓   Guardar cambios"
                            onAction="#handleGuardarCambios"
                            styleClass="reg-cliente-btn-save"/>
                </HBox>

            </VBox>
        </StackPane>
    </center>

</BorderPane>
